{
  "name": "shirone",
  "type": "module",
  "version": "0.0.10",
  "description": "An expressive, anime-inspired blog theme built on Material 3 Expressive, Astro 7, and Svelte 5",
  "license": "MIT",
  "author": "matsuzaka-yuki",
  "homepage": "https://shirone.mysqil.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LyraVoid/Shirone.git"
  },
  "bugs": {
    "url": "https://github.com/LyraVoid/Shirone/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog-theme",
    "material-design-3",
    "material-3-expressive",
    "m3e",
    "svelte-5",
    "tailwindcss-4"
  ],
  "scripts": {
    "dev": "node scripts/content/sync.mjs && node scripts/icons/generate-local-icons.mjs && node scripts/images/generate-moment-thumbnails.mjs && astro dev",
    "start": "node scripts/content/sync.mjs && node scripts/icons/generate-local-icons.mjs && node scripts/images/generate-moment-thumbnails.mjs && astro dev",
    "check": "astro check",
    "content": "node scripts/content/cli.mjs",
    "content:status": "node scripts/content/status.mjs",
    "content:sync": "node scripts/content/sync.mjs",
    "content:clean": "node scripts/content/clean.mjs",
    "content:watch": "node scripts/content/sync.mjs --watch",
    "content:validate": "node scripts/content/sync.mjs --dry-run",
    "content:eject": "node scripts/content/eject.mjs",
    "content:export": "node scripts/content/export.mjs",
    "design:lint": "node scripts/check-design.mjs",
    "check:manifest": "node scripts/check-manifest.mjs && node scripts/check-markdown-manifest.mjs && node scripts/check-skills.mjs",
    "skills:package": "node scripts/package-skills.mjs",
    "check:markdown-manifest": "node scripts/check-markdown-manifest.mjs",
    "icons:generate": "node scripts/icons/generate-local-icons.mjs",
    "images:generate": "node scripts/images/generate-moment-thumbnails.mjs",
    "anime:sync": "node scripts/anime/sync.mjs",
    "fonts:check": "node scripts/fonts/check-fonts.mjs",
    "fonts:subset": "node scripts/fonts/subset-fonts.mjs",
    "build": "node scripts/content/sync.mjs && node scripts/icons/generate-local-icons.mjs && node scripts/images/generate-moment-thumbnails.mjs && node scripts/fonts/subset-fonts.mjs && astro build && npx pagefind --site dist && node scripts/fonts/check-fonts.mjs",
    "preview": "astro preview",
    "lighthouse:collect": "lhci collect --config=lighthouserc.cjs",
    "lighthouse:assert": "lhci assert --config=lighthouserc.cjs",
    "lighthouse:desktop": "node scripts/lighthouse/run.mjs --device=desktop",
    "lighthouse:mobile": "node scripts/lighthouse/run.mjs --device=mobile",
    "lighthouse": "node scripts/lighthouse/run.mjs --device=desktop",
    "astro": "astro",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/new-post.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "preinstall": "npx only-allow pnpm",
    "test": "playwright test",
    "perf:measure": "node scripts/perf/measure.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@expressive-code/core": "^0.44.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fancyapps/ui": "^6.1.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.90",
    "@iconify/svelte": "^5.2.2",
    "@material/material-color-utilities": "^0.4.0",
    "@panzoom/panzoom": "4.6.2",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4",
    "astro": "7.2.9",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.2.0",
    "hast-util-from-html": "2.0.3",
    "hastscript": "^9.0.1",
    "katex": "^0.18.4",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "markdown-it": "^14.3.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "oddmisc": "^1.2.8",
    "overlayscrollbars": "^2.16.0",
    "pagefind": "^1.5.2",
    "qrcode": "^1.5.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-directive-rehype": "^0.4.2",
    "remark-github-admonitions-to-directives": "^1.0.5",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.4",
    "stylus": "^0.64.0",
    "subset-font": "2.5.0",
    "svelte": "^5.56.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.11",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@iconify-json/simple-icons": "^1.2.93",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-yaml": "^4.1.2",
    "@swup/scroll-plugin": "3.3.2",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.2",
    "vite": "^8.2.2"
  },
  "packageManager": "pnpm@9.14.4"
}
