{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "site configuration override",
  "description": "Shirone site config schema generated from @/types/config.SiteConfig",
  "type": "object",
  "properties": {
    "site": {
      "type": "string"
    },
    "base": {
      "anyOf": [
        {},
        {
          "type": "string"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "ogImage": {
      "anyOf": [
        {},
        {
          "type": "string"
        }
      ],
      "description": "默认社交媒体分享预览图（og:image / twitter:image），支持本地相对路径或远程绝对链接。未配置时自动回退为第一张桌面版横幅壁纸。"
    },
    "topAppBar": {
      "type": "object",
      "properties": {
        "contentAlign": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "left"
              ]
            },
            {
              "type": "string",
              "enum": [
                "center"
              ]
            }
          ],
          "description": "桌面端标题与导航内容组的对齐方式。"
        }
      },
      "additionalProperties": false
    },
    "displaySettings": {
      "anyOf": [
        {},
        {
          "type": "object",
          "properties": {
            "colorStyle": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否在显示设置面板展示配色风格（9 宫格）选择器（默认 true）"
            },
            "colorSpec": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否在显示设置面板展示 Color Spec（调色规范 2021 / 2025）切换器（默认 true）"
            },
            "wallpaperMode": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否在显示设置面板展示 Page background（页面背景 纯色 / 横幅）切换器（默认 true）"
            },
            "layoutMode": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否在显示设置面板展示 Layout（文章列表布局 列表 / 网格）切换器（默认 true）"
            },
            "reduceMotion": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否在显示设置面板展示 Reduce motion（减少动效）切换器（默认 true）"
            },
            "texture": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否在显示设置面板展示背景纹理选择器（默认 true，且受 texture.enable 控制）"
            },
            "rainyDay": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否在显示设置面板展示雨滴特效开关（默认 true，且受 rainyDay.enable 控制）"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "显示设置浮层各切换项的前端可见性控制"
    },
    "lang": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "en"
          ]
        },
        {
          "type": "string",
          "enum": [
            "zh_CN"
          ]
        },
        {
          "type": "string",
          "enum": [
            "zh_TW"
          ]
        },
        {
          "type": "string",
          "enum": [
            "ja"
          ]
        },
        {
          "type": "string",
          "enum": [
            "ko"
          ]
        },
        {
          "type": "string",
          "enum": [
            "es"
          ]
        },
        {
          "type": "string",
          "enum": [
            "th"
          ]
        },
        {
          "type": "string",
          "enum": [
            "vi"
          ]
        },
        {
          "type": "string",
          "enum": [
            "tr"
          ]
        },
        {
          "type": "string",
          "enum": [
            "id"
          ]
        }
      ]
    },
    "timeZone": {
      "type": "string",
      "description": "IANA time zone used to interpret precise content timestamps."
    },
    "themeColor": {
      "type": "object",
      "properties": {
        "hue": {
          "type": "number"
        },
        "fixed": {
          "type": "boolean"
        },
        "style": {
          "type": "string"
        },
        "spec": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "wallpaperMode": {
      "type": "object",
      "properties": {
        "defaultMode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "banner"
              ]
            },
            {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "texture": {
      "anyOf": [
        {},
        {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        {
          "type": "object",
          "properties": {
            "enable": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否启用纹理系统"
            },
            "defaultPreset": {
              "anyOf": [
                {},
                {
                  "type": "string",
                  "enum": [
                    "none"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "starlight"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "cyber-dots"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "topography"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "geometric"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "sakura"
                  ]
                }
              ],
              "description": "默认生效的纹理预设"
            },
            "defaultOpacity": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "默认纹理不透明度 (0.05 ~ 0.25, 默认 0.12)"
            },
            "allowMotion": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "是否允许背景微动效 (在开启 reduced-motion 时强制静止)"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "页面背景纹理系统配置，支持布尔值直接开关或详细配置对象"
    },
    "rainyDay": {
      "anyOf": [
        {},
        {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        {
          "type": "object",
          "properties": {
            "enable": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "总开关（构建期生效，默认 false）：true 时才编译进产物；false 时该特性零 DOM、零样式、零 bundle"
            },
            "defaultEnabled": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "主题启用后访客首次进入时的默认状态；访客可在显示设置里关掉（存 localStorage）"
            },
            "intensity": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "雨滴密度 0-1（0.3 稀疏、0.5 适中、0.8 密集）"
            },
            "speed": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "下落速度 0-10"
            },
            "brightness": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "亮度 0-1"
            },
            "normal": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "法线强度 0-3（雨滴立体感）"
            },
            "zoom": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "雨滴图案缩放 0.1-3（越大雨滴越大、越稀疏）"
            },
            "blurIntensity": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "玻璃模糊强度 0-10（太大会糊掉背景）"
            },
            "blurIterations": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "模糊迭代次数 1-64（越大越慢）"
            },
            "lightning": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "闪电效果"
            },
            "panning": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "镜头平移"
            },
            "postProcessing": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "后处理（开启更细腻，稍耗性能）"
            },
            "fps": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "限帧 15-120（省电关键）"
            },
            "mobile": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "移动端是否启用（默认关闭，省电）"
            },
            "respectReducedMotion": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "尊重系统「减少动效」设置（默认开）"
            },
            "skipOnSlowNetwork": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "弱网 / 省流（saveData 或 2G）不加载（默认开）"
            },
            "pauseWhenHidden": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "切到后台标签页时暂停渲染（默认开）"
            },
            "mistStrength": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "雨雾浓度 0-1：竖向南端的浓度——banner 带内恒为不透明（雨最明显，接替淡出的横幅图片），\n往下在 `mistFadeVh` 内过渡到本值：正文区保持浅色 M3 底 + 背景纹理 + 雨雾。默认 0.4。"
            },
            "mistFadeVh": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "蒙版过渡长度（vh，0-100，默认 12）：从 banner 带底部起多少视口高度内，\n蒙版从「不透明」过渡到 `mistStrength`。0 = 硬边。"
            },
            "bodyRain": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "@deprecated 正文区雨丝已整体移除（refactor(rainy-day): remove the CSS body rain overlay）。\n保留该字段只为让升级后的旧配置继续通过类型检查与构建；设置它不再有任何效果。"
            },
            "bodyRainOpacity": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "@deprecated 同上，不再生效"
            },
            "bodyRainSpeed": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "@deprecated 同上，不再生效"
            },
            "bgFadeMs": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "轮播换图时雨层的交叉淡入时长（毫秒；0 = 直接切换）"
            },
            "lazy": {
              "anyOf": [
                {},
                {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ],
              "description": "延后到 load + 浏览器空闲再挂载，把特效库移出首屏关键路径（默认开）"
            },
            "idleDelayMs": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "`lazy` 的 idle 兜底超时（毫秒）：最迟这么久一定挂载"
            },
            "fadeInMs": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "挂载完成后的淡入时长（毫秒；0 = 不淡入）"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "雨滴窗玻璃特效（Banner 上的 WebGL 雨滴），支持布尔值直接开关或详细配置对象。\n重量级可选特性：未配置即关闭，关闭时零 DOM / 零样式 / 零 bundle。"
    },
    "banner": {
      "type": "object",
      "properties": {
        "src": {
          "type": "object",
          "properties": {
            "desktop": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "light": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "dark": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "mobile": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "light": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "dark": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "position": {
          "anyOf": [
            {},
            {
              "type": "string",
              "enum": [
                "center"
              ]
            },
            {
              "type": "string",
              "enum": [
                "top"
              ]
            },
            {
              "type": "string",
              "enum": [
                "bottom"
              ]
            }
          ]
        },
        "dim": {
          "type": "object",
          "properties": {
            "enable": {
              "type": "boolean"
            },
            "opacity": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "homeText": {
          "type": "object",
          "properties": {
            "enable": {
              "type": "boolean"
            },
            "title": {
              "type": "string"
            },
            "subtitle": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "首页副标题文本，支持单条字符串或多条交替循环的字符串数组"
            },
            "typewriter": {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "speed": {
                  "type": "number",
                  "description": "打字速度（每个字符间隔，毫秒，默认 120）"
                },
                "deleteSpeed": {
                  "anyOf": [
                    {},
                    {
                      "type": "number"
                    }
                  ],
                  "description": "回退反向删除速度（每个字符间隔，毫秒，默认 50）"
                },
                "pauseTime": {
                  "anyOf": [
                    {},
                    {
                      "type": "number"
                    }
                  ],
                  "description": "打字完成后等待停顿时间（毫秒，默认 2000）"
                },
                "loop": {
                  "type": "boolean",
                  "description": "完成后是否循环播放（默认 true）"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "carousel": {
          "type": "object",
          "properties": {
            "enable": {
              "type": "boolean"
            },
            "interval": {
              "type": "number"
            },
            "fadeDuration": {
              "anyOf": [
                {},
                {
                  "type": "number"
                }
              ],
              "description": "交叉淡入淡出过渡时长（毫秒，默认 1200）"
            },
            "animation": {
              "anyOf": [
                {},
                {
                  "type": "string",
                  "enum": [
                    "none"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "ken-burns"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "zoom-in"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "zoom-out"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "pan-left"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "pan-right"
                  ]
                }
              ],
              "description": "运镜呼吸动画模式：\"ken-burns\"（默认，序列运镜）| \"zoom-in\" | \"zoom-out\" | \"pan-left\" | \"pan-right\" | \"none\""
            }
          },
          "additionalProperties": false
        },
        "waves": {
          "type": "object",
          "properties": {
            "enable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "imageOptimization": {
      "anyOf": [
        {},
        {
          "type": "object",
          "properties": {
            "noReferrerDomains": {
              "anyOf": [
                {},
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "添加 `referrerpolicy=\"no-referrer\"` 的远程图片域名，支持 `*.example.com` 通配符。"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Markdown 正文图片处理配置。"
    },
    "toc": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "depth": {
          "anyOf": [
            {
              "type": "number",
              "enum": [
                1
              ]
            },
            {
              "type": "number",
              "enum": [
                2
              ]
            },
            {
              "type": "number",
              "enum": [
                3
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "progressIndicator": {
      "type": "object",
      "properties": {
        "style": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "dual"
              ]
            },
