{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "profile configuration override",
  "description": "Shirone profile config schema generated from @/types/config.ProfileConfig",
  "type": "object",
  "properties": {
    "avatar": {
      "anyOf": [
        {},
        {
          "type": "string"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "bio": {
      "anyOf": [
        {},
        {
          "type": "string"
        }
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
