# 双仓部署示例：内容仓推送 -> 本仓库重新构建 -> 部署。
#
# 这个文件不会被 GitHub Actions 执行（扩展名不是 .yml），因为 Shirone 的使用者
# 部署在不同平台上，仓库只提供通用的触发与构建部分。
#
# 启用方式：
#   1. 复制为 .github/workflows/deploy.yml；
#   2. 把 CONTENT_REPOSITORY 换成你的内容仓；
#   3. 替换最后的「Deploy」一步为你的平台命令（文件末尾给了四种常见写法）；
#   4. 在仓库 Settings > Secrets and variables > Actions 配置所需凭据。
#
# 前置条件见 docs/content-separation.md。

name: Deploy

on:
  # 代码变更。
  push:
    branches: [main]
    paths-ignore:
      - "docs/**"
      - "rules/**"
      - "README*.md"
      - "*.md"
  # 内容仓推送后由 trigger-build.yml 发来的事件（由 trigger-build.yml.example 去掉 .example 启用）。
  repository_dispatch:
    types: [content-updated]
  # 手动触发；回滚时把 content_ref 填成旧的内容 SHA。
  workflow_dispatch:
    inputs:
      content_ref:
        description: "内容仓 ref 或 commit SHA（留空使用 main）"
        required: false
        default: ""
  # 兜底：repository_dispatch 事件偶尔会丢，每天重建一次保证最终一致。
  schedule:
    - cron: "17 4 * * *"

# 并发控制：同一时间只允许一个部署流水线运行。
# 无论是代码仓代码推送（push）还是内容仓触发（repository_dispatch），
# 均归入同一个 deploy 并发通道。新的构建请求会自动取消正在运行中的旧构建，
# 确保始终以最新一次提交（最新代码 + 最新内容）为准，杜绝并发竞争。
concurrency:
  group: deploy
  cancel-in-progress: true

permissions:
  contents: read

env:
  # TODO: 替换为你的内容仓。
  CONTENT_REPOSITORY: OWNER/shirone-content
  CONTENT_WORKING_COPY: .content-src

jobs:
  deploy:
    name: Build and deploy
    runs-on: ubuntu-latest
    timeout-minutes: 20
    env:
      CI: true
      # 让 content:sync 走「本地目录」模式，内容由下面的 checkout 步骤取得。
      CONTENT_DIR: .content-src

    steps:
      - name: Resolve content ref
        id: target
        # 经 env 传递而不是直接内插到脚本里：client_payload 属于外部输入，
        # 直接内插会形成 shell 注入面。
        env:
          PAYLOAD_SHA: ${{ github.event.client_payload.sha }}
          INPUT_REF: ${{ github.event.inputs.content_ref }}
        run: |
          set -euo pipefail
          ref="${PAYLOAD_SHA:-}"
          [ -n "$ref" ] || ref="${INPUT_REF:-}"
          [ -n "$ref" ] || ref="main"
          echo "ref=$ref" >> "$GITHUB_OUTPUT"

      - name: Checkout theme
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2

      - name: Checkout content
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          repository: ${{ env.CONTENT_REPOSITORY }}
          ref: ${{ steps.target.outputs.ref }}
          path: ${{ env.CONTENT_WORKING_COPY }}
          # 内容仓公开时可以删掉 token 一行。
          token: ${{ secrets.CONTENT_REPO_TOKEN }}
          persist-credentials: false

      - name: Record content commit
        id: content
        run: |
          set -euo pipefail
          echo "sha=$(git -C '${{ env.CONTENT_WORKING_COPY }}' rev-parse HEAD)" >> "$GITHUB_OUTPUT"

      - name: Set up pnpm
        uses: pnpm/action-setup@a7487c7e89a18df4991f7f222e4898a00d66ddda # v4.1.0
        with:
          version: 9.14.4
          run_install: false

      - name: Set up Node.js
        uses: actions/setup-node@cdca7365b2dadb8aad0a33bc7601856ffabcc48e # v4.3.0
        with:
          node-version: 22
          cache: pnpm
          cache-dependency-path: pnpm-lock.yaml

      - name: Restore build caches
        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          # 缩略图按源图内容哈希复用，因此跨 commit 的缓存命中是有效的。
          path: |
            .astro
            node_modules/.astro
            public/assets/moments/thumbnails
          key: ${{ runner.os }}-shirone-${{ hashFiles('pnpm-lock.yaml', 'astro.config.mjs') }}-${{ steps.content.outputs.sha }}
          restore-keys: |
            ${{ runner.os }}-shirone-${{ hashFiles('pnpm-lock.yaml', 'astro.config.mjs') }}-
            ${{ runner.os }}-shirone-

      - name: Install dependencies
        run: pnpm install --frozen-lockfile --prefer-offline

      # 独立成步，而不是依赖 `pnpm build` 内部再跑一次：
      # 内容问题（含 config/*.yaml 的类型校验）与构建问题因此在日志里天然分开，
      # 且 fonts:subset 需要内容与配置都已就位。
      - name: Materialize content and config
        run: pnpm content:sync

      - name: Build site
        run: pnpm build
        env:
          # 按需补齐可选功能的凭据。
          BILI_SESSDATA: ${{ secrets.BILI_SESSDATA }}

      # ───────────────────────────────────────────────────────────────────────
      # 部署：按你的平台替换这一步，下面给了四种常见写法。
      # ───────────────────────────────────────────────────────────────────────
      - name: Deploy
        run: |
          echo "把这一步替换成你的平台部署命令，构建产物在 dist/。" >&2
          exit 1

      # 变体 A：Vercel（关闭 Vercel 的 Git 自动构建，改由 Actions 交付产物）
      # - name: Deploy to Vercel
      #   run: |
      #     pnpm dlx vercel@latest deploy dist --prod --yes \
      #       --token "$VERCEL_TOKEN"
      #   env:
      #     VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
      #     VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
      #     VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}

      # 变体 B：GitHub Pages（需要把顶层 permissions 改为
      # `contents: read` + `pages: write` + `id-token: write`，并配置 environment）
      # - name: Upload Pages artifact
      #   uses: actions/upload-pages-artifact@<pinned-sha>
      #   with:
      #     path: dist
      # - name: Deploy to Pages
      #   uses: actions/deploy-pages@<pinned-sha>

      # 变体 C：自有服务器（rsync over SSH）
      # - name: Deploy to server
      #   env:
      #     DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
      #     DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
      #     DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
      #     DEPLOY_DIR: /www/wwwroot/shirone
      #   run: |
      #     set -euo pipefail
      #     mkdir -p ~/.ssh && chmod 700 ~/.ssh
      #     printf '%s\n' "$DEPLOY_SSH_KEY" > ~/.ssh/deploy_key
      #     chmod 600 ~/.ssh/deploy_key
      #     ssh-keyscan -H "$DEPLOY_HOST" >> ~/.ssh/known_hosts
      #     rsync -az --delete -e "ssh -i ~/.ssh/deploy_key" \
      #       dist/ "$DEPLOY_USER@$DEPLOY_HOST:$DEPLOY_DIR/dist/"

      # 变体 D：平台自建构建（Netlify / EdgeOne 等 Deploy Hook）。
      # 这种平台会自己 clone 代码仓并执行 `pnpm build`，因此需要在平台的环境变量里
      # 配置 CONTENT_REPO_URL（私有仓用 https://x-access-token:<TOKEN>@... 形式），
      # 由 content:sync 在平台侧拉取内容。此时本 workflow 只负责触发：
      # - name: Trigger platform build
      #   env:
      #     DEPLOY_HOOK: ${{ secrets.DEPLOY_HOOK }}
      #   run: |
      #     set -euo pipefail
      #     curl --fail-with-body --silent --show-error --retry 3 --retry-delay 2 \
      #       --max-time 30 --request POST "$DEPLOY_HOOK"

      - name: Summarize
        if: always()
        run: |
          set -euo pipefail
          {
            echo "### Shirone deploy"
            echo ""
            echo "- 内容仓：\`${CONTENT_REPOSITORY}\`"
            echo "- 内容 ref：\`${{ steps.target.outputs.ref }}\`"
            echo "- 内容 commit：\`${{ steps.content.outputs.sha }}\`"
            if [ -f content.lock.json ]; then
              echo ""
              echo "<details><summary>content.lock.json</summary>"
              echo ""
              echo '```json'
              cat content.lock.json
              echo '```'
              echo ""
              echo "</details>"
            fi
          } >> "$GITHUB_STEP_SUMMARY"
