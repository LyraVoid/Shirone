---
/** 项目页：配置层规则在构建期结合数据层传入交互岛，路由负责开关与编排。 */
import ProjectSection from "@components/organisms/ProjectSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { projectsConfig } from "@/config/projectsConfig";
import { resolveI18nText } from "@utils/i18n-utils";
import { resolveProjectsData } from "@/utils/feature-data";

if (!projectsConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(projectsConfig.title, I18nKey.projects);
const pageDescription = resolveI18nText(projectsConfig.description, I18nKey.projectsBanner);

const items = resolveProjectsData(projectsConfig);
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	page="projects"
>
	<ProjectSection
		categories={projectsConfig.categories}
		items={items}
		title={pageTitle}
		subtitle={pageDescription}
		client:visible
	/>
</MainGridLayout>
