---
import { type CollectionEntry, render } from "astro:content";
import path from "node:path";
import IconButton from "@components/atoms/action/IconButton.svelte";
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import ImageWrapper from "@components/molecules/ImageWrapper.astro";
import LastUpdatedNotice from "@components/molecules/LastUpdatedNotice.astro";
import License from "@components/molecules/License.astro";
import PostMetadata from "@components/molecules/PostMeta.astro";
import ArticleDiscovery from "@components/organisms/ArticleDiscovery.astro";
import ArticleShare from "@components/organisms/ArticleShare.svelte";
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import EncryptedContent from "@components/organisms/EncryptedContent.astro";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { discoverArticles } from "@utils/article-discovery";
import { resolveAsset } from "@utils/asset-utils";
import { resolveRuntimeMode } from "@utils/backend-client.mjs";
import { getPublishedInstant, getUpdatedInstant } from "@utils/content-date";
import { createPostContentProvider } from "@utils/content-provider";
import { getSortedPosts, type PostForList } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { renderDynamicMarkdown } from "@utils/dynamic-markdown.mjs";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { getSourceMarkdownSyntaxSnapshot } from "@utils/markdown-source-syntaxes.mjs";
import {
	hasMarkdownSyntax,
	mergeMarkdownSyntaxSnapshots,
} from "@utils/markdown-syntaxes.mjs";
import { initPostIdMap } from "@utils/permalink-utils";
import {
	type PostViewModel,
	postViewModelFromStatic,
} from "@utils/post-view-model";
import {
	getDir,
	getPostUrl,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import katexStylesheet from "katex/dist/katex.css?url";
import overlayScrollbarsStylesheet from "overlayscrollbars/overlayscrollbars.css?url";
import {
	articleConfig,
	commentConfig,
	licenseConfig,
	profileConfig,
	resolveArticleDiscoveryOptions,
	resolveArticleShareOptions,
	resolveCommentOptions,
	resolveLastUpdatedNoticeOptions,
	resolveUmamiOptions,
	siteConfig,
	umamiConfig,
} from "@/config";

export const prerender = resolveRuntimeMode(process.env).mode === "static";

export async function getStaticPaths() {
	if (resolveRuntimeMode(process.env).mode === "dynamic") return [];
	const blogEntries = await getSortedPosts();
	initPostIdMap(blogEntries);

	const discoveryCandidates = blogEntries.map((entry) => ({
		slug: entry.id,
		data: entry.data,
	}));
	const discoveryOptions = resolveArticleDiscoveryOptions(articleConfig);

	const paths: {
		params: { slug: string };
		props: {
			entry: CollectionEntry<"posts">;
			discovery: { related: PostForList[]; random: PostForList[] };
		};
	}[] = [];

	for (const entry of blogEntries) {
		const defaultSlug = removeFileExtension(entry.id);
		const current = discoveryCandidates.find(
			(candidate) => candidate.slug === entry.id,
		);
		const discovery =
			discoveryOptions && current
				? discoverArticles(
						current,
						discoveryCandidates,
						discoveryOptions.relatedCount,
						discoveryOptions.randomCount,
					)
				: { related: [], random: [] };

		paths.push({
			params: { slug: defaultSlug },
			props: { entry, discovery },
		});

		if (entry.data.alias) {
			let alias = entry.data.alias.replace(/^\/+/, "").replace(/\/+$/, "");
			if (alias.startsWith("posts/")) {
				alias = alias.replace(/^posts\//, "");
			}
			if (alias && alias !== defaultSlug) {
				paths.push({
					params: { slug: alias },
					props: { entry, discovery },
				});
			}
		}
	}

	return paths;
}

type Discovery = { related: PostForList[]; random: PostForList[] };
type RenderFrontmatter = {
	words?: number;
	minutes?: number;
	markdownSyntaxes?: Parameters<typeof hasMarkdownSyntax>[0];
};

let entry: CollectionEntry<"posts"> | undefined;
let post: PostViewModel;
let discovery: Discovery = { related: [], random: [] };
let Content: Awaited<ReturnType<typeof render>>["Content"] | undefined;
let headings: MarkdownHeading[] = [];
let renderFrontmatter: RenderFrontmatter = {};
let dynamicHtml = "";
const dynamicRuntime = resolveRuntimeMode(process.env).mode === "dynamic";

if (dynamicRuntime) {
	const slug = Astro.params.slug;
	if (!slug) return new Response(null, { status: 404 });
	const cookie = Astro.request.headers.get("cookie");
	const provider = createPostContentProvider({
		environment: process.env,
		defaultHeaders: cookie ? { Cookie: cookie } : undefined,
	});
	const dynamicPost = await provider.getPost(slug);
	if (!dynamicPost) return new Response(null, { status: 404 });
	post = dynamicPost;
	const rendered = await renderDynamicMarkdown(post.body, {
		...post.metadata,
		title: post.title,
	});
	dynamicHtml = rendered.html;
	headings = rendered.headings;
	renderFrontmatter = rendered.frontmatter;
} else {
	const props = Astro.props as {
		entry: CollectionEntry<"posts">;
		discovery: Discovery;
	};
	entry = props.entry;
	discovery = props.discovery;
	post = postViewModelFromStatic(entry);
	const rendered = await render(entry);
	Content = rendered.Content;
	headings = rendered.headings;
	renderFrontmatter = rendered.remarkPluginFrontmatter;
}

const isEncrypted = Boolean(post.password && post.password.trim().length > 0);
const scope = `post:${post.id}`;

const renderedMarkdownSyntaxes = renderFrontmatter.markdownSyntaxes;
const sourceMarkdownSyntaxes = hasMarkdownSyntax(
	renderedMarkdownSyntaxes,
	"expressive-code",
)
	? undefined
	: getSourceMarkdownSyntaxSnapshot(post.body);
const markdownSyntaxes = mergeMarkdownSyntaxSnapshots(
	renderedMarkdownSyntaxes,
	sourceMarkdownSyntaxes,
);
const hasMath = hasMarkdownSyntax(markdownSyntaxes, "math");
const markdownStylesheetAssets =
	await getMarkdownStylesheetAssets(markdownSyntaxes);
const effectiveHeadings = isEncrypted ? [] : headings;
const imageBasePath = entry?.filePath
	? path.relative(path.resolve("src"), path.dirname(entry.filePath))
	: entry
		? path.join("content/posts/", getDir(entry.id))
		: "";
const effectiveUpdatedDate = post.updated ?? post.published;
const publishedInstant = entry
	? getPublishedInstant(entry.data)
	: post.published;
const updatedInstant = entry
	? getUpdatedInstant(entry.data)
	: effectiveUpdatedDate;
const postCommentEnabled =
	post.comment && Boolean(resolveCommentOptions(commentConfig));
const lastUpdatedNotice = resolveLastUpdatedNoticeOptions(articleConfig);
const shareOptions = resolveArticleShareOptions(articleConfig);
const umamiEnabled = resolveUmamiOptions(umamiConfig) !== null;
const authorAvatarUrl = shareOptions
	? await resolveAsset(profileConfig.avatar ?? "")
	: "";

const effectiveDescription =
	isEncrypted && post.hideHomeContent
		? i18n(I18nKey.postEncryptedSummary)
		: post.description || post.title;

const canonicalPostUrl = entry
	? getPostUrl(entry)
	: getPostUrlBySlug(post.slug);
const wordCount = Number(renderFrontmatter.words ?? 0);
const readingMinutes = Number(renderFrontmatter.minutes ?? 1);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	description: effectiveDescription,
	keywords: post.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: entry?.data.publishedAt
		? publishedInstant.toISOString()
		: entry
			? formatDateToYYYYMMDD(post.published)
			: publishedInstant.toISOString(),
	dateModified: entry?.data.updatedAt
		? updatedInstant.toISOString()
		: entry
			? formatDateToYYYYMMDD(effectiveUpdatedDate)
			: updatedInstant.toISOString(),
	inLanguage: post.lang
		? post.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
---

<MainGridLayout banner={post.image} title={post.title} description={effectiveDescription} bannerDate={formatDateToYYYYMMDD(post.published)} lang={post.lang} setOGTypeArticle={true} headings={effectiveHeadings} postCategory={post.category || undefined} page="post" hasComments={postCommentEnabled}>
    {hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={katexStylesheet} />}
    {hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={overlayScrollbarsStylesheet} />}
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<Card color="var(--card-bg)" radius="l" class="post-card z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
			<!-- word count and reading time -->
			<div class="flex flex-row text-[var(--on-surface-variant)] gap-5 mb-3 transition onload-animation">
				<div class="flex flex-row items-center">
					<div class="transition h-6 w-6 rounded-md bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
						<Icon name="material-symbols:notes-rounded"></Icon>
					</div>
					<div class="text-sm">{wordCount} {" " + i18n(wordCount === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</div>
				</div>
				<div class="flex flex-row items-center">
					<div class="transition h-6 w-6 rounded-md bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
						<Icon name="material-symbols:schedule-outline-rounded"></Icon>
					</div>
					<div class="text-sm">{readingMinutes} {" " + i18n(readingMinutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</div>
				</div>
				{umamiEnabled && (
					<div class="flex flex-row items-center">
						<UmamiStats variant="meta" path={canonicalPostUrl} />
					</div>
				)}
			</div>

			<!-- title -->
			<div class="relative onload-animation">
				<div
					data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
					class="transition w-full block font-bold mb-3
					text-3xl md:text-[2.25rem]/[2.75rem]
					text-[var(--on-surface)]
					flex items-center gap-3"
				>
					<AccentBar size="large" />
					<div class="inline-block">
						{post.title}
					</div>
					<IconButton
						id="copy-post-link"
						label={i18n(I18nKey.copyLink)}
						class="ml-auto shrink-0"
					>
						<Icon name="material-symbols:link-rounded" class="text-[1.25rem]" />
					</IconButton>
				</div>
			</div>

			<!-- metadata -->
			<div class="onload-animation">
				{isEncrypted && post.hideHomeContent ? (
					<div class="flex flex-wrap items-center gap-2 mb-5">
						<div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-container-highest)] text-xs font-semibold text-[var(--primary)]">
							<Icon name="material-symbols:lock-rounded" class="text-sm" />
							<span>{i18n(I18nKey.postEncryptedBadge)}</span>
						</div>
					</div>
				) : (
					<PostMetadata
						class="mb-5"
						published={post.published}
						updated={post.updated}
						tags={post.tags}
						category={post.category}
					></PostMetadata>
				)}
				{!post.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
			</div>

            <!-- always show cover as long as it has one -->

			{post.image &&
				<ImageWrapper
					id="post-cover"
					src={post.image}
					basePath={imageBasePath}
					class="mb-8 rounded-xl banner-container onload-animation"
					loading="eager"
					fetchPriority="high"
					widths={[360, 720, 1080, 1440]}
					sizes="(min-width: 1280px) 720px, (min-width: 768px) calc(100vw - 22rem), calc(100vw - 3.5rem)"
					formats={["avif", "webp"]}
					quality={65}
				/>
			}

            {isEncrypted ? (
                <EncryptedContent
                    password={post.password!}
                    scope={scope}
                    hint={post.passwordHint}
                >
					{dynamicRuntime ? <Fragment set:html={dynamicHtml} /> : Content && <Content />}
                </EncryptedContent>
            ) : (
                <Markdown class="mb-6 onload-animation">
					{dynamicRuntime ? <Fragment set:html={dynamicHtml} /> : Content && <Content />}
                </Markdown>
            )}

			{licenseConfig.enable && <License title={post.title} slug={post.slug} pubDate={post.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

			{shareOptions && (
				<ArticleShare
					client:visible
					options={shareOptions}
					title={post.title}
					description={effectiveDescription}
					author={profileConfig.name}
					published={formatDateToYYYYMMDD(post.published)}
					siteTitle={siteConfig.title}
					postPath={canonicalPostUrl}
					coverSelector={post.image ? "#post-cover img" : undefined}
					avatarUrl={authorAvatarUrl}
					class="mb-6 rounded-xl onload-animation"
				/>
			)}

			<ArticleDiscovery
				related={discovery.related}
				random={discovery.random}
				class="onload-animation"
			/>

		</Card>
    </div>

    <CommentSection
        context={{
            key: `post:${post.id}`,
            path: canonicalPostUrl,
            title: post.title,
            language: post.lang || siteConfig.lang,
        }}
        postCommentEnabled={post.comment}
        class="onload-animation"
    />

    {lastUpdatedNotice && (
        <LastUpdatedNotice
            date={updatedInstant}
            minimumAgeDays={lastUpdatedNotice.minimumAgeDays}
            class="mb-4 onload-animation"
        />
    )}

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        {post.nextSlug ? (
            <Card
                href={post.nextUrl || getPostUrlBySlug(post.nextSlug)}
                color="var(--card-bg)"
                radius="l"
                class="post-nav post-nav--prev w-full font-bold active:scale-95 h-[3.75rem] max-w-full px-4 !flex items-center !justify-start gap-4"
            >
                <Icon name="material-symbols:chevron-left-rounded" class="post-nav__arrow text-[2rem] text-[var(--primary)]" />
                <div class="post-nav__title overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-75">
                    {post.nextTitle}
                </div>
            </Card>
        ) : (
            <div class="w-full"></div>
        )}

        {post.prevSlug ? (
            <Card
                href={post.prevUrl || getPostUrlBySlug(post.prevSlug)}
                color="var(--card-bg)"
                radius="l"
                class="post-nav post-nav--next w-full font-bold active:scale-95 h-[3.75rem] max-w-full px-4 !flex items-center !justify-end gap-4"
            >
                <div class="post-nav__title overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-75">
                    {post.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="post-nav__arrow text-[2rem] text-[var(--primary)]" />
            </Card>
        ) : (
            <div class="w-full"></div>
        )}
    </div>

</MainGridLayout>

<style is:global lang="stylus">
	/* ???/????? hover ????????????????????
	   reduced-motion ??? motion-reduced ???????????? */
	.post-nav
		.post-nav__arrow
			transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)

		.post-nav__title
			transition: color var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover .post-nav__title
			color: var(--primary)

		&--prev:hover .post-nav__arrow
			transform: translateX(-0.25rem)

		&--next:hover .post-nav__arrow
			transform: translateX(0.25rem)
</style>
