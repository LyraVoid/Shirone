---
/**
 * 分类索引页：全部分类的总览入口。
 * 纯 SSR 直出（无客户端岛）：规格表行 = MetaIcon tonal 徽标 + 分类名 +
 * 点线引导 + 计数（与 SiteStats/PostMeta 同一视觉语言），
 * 行点击进入归档页的对应分类过滤（/archive/?category=x）。
 */
import Card from "@components/atoms/display/Card.svelte";
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import PageHeader from "@components/atoms/display/PageHeader.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCategoryList } from "@utils/content-utils";

const categories = await getCategoryList();
const totalPosts = categories.reduce(
	(sum, category) => sum + category.count,
	0,
);
const categorySummary = `${categories.length} ${i18n(I18nKey.categoriesCount)} · ${totalPosts} ${i18n(I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.categories)} description={categorySummary} page="categories">
	<Card color="var(--card-bg)" radius="l" class="category-index px-8 py-6">
		<PageHeader
			icon="material-symbols:folder-outline-rounded"
			title={i18n(I18nKey.categories)}
				subtitle={categorySummary}
		/>
		{categories.length > 0 && (
			<ul class="category-index__list">
				{categories.map((category) => (
					<li>
						<a class="category-index__row m3-state-layer" href={category.url}>
							<MetaIcon icon="material-symbols:folder-outline-rounded" />
							<span class="category-index__name">{category.name}</span>
							<span class="category-index__rule" aria-hidden="true"></span>
							<span class="category-index__count">{category.count}</span>
						</a>
					</li>
				))}
			</ul>
		)}
		{categories.length === 0 && (
			<div class="category-index__empty">
				<span>{i18n(I18nKey.noData)}</span>
			</div>
		)}
	</Card>
</MainGridLayout>

<style lang="stylus">
@import "../styles/breakpoints.styl"

.category-index
	display: block

	&__list
		display: grid
		grid-template-columns: repeat(2, minmax(0, 1fr))
		gap: var(--m3e-space-2) var(--m3e-space-4)
		margin: 0
		padding: 0
		list-style: none

	&__row
		display: flex
		align-items: center
		gap: var(--m3e-space-3)
		min-height: 3.5rem
		padding: var(--m3e-space-3) var(--m3e-space-4)
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		text-decoration: none
		--m3e-state-color: var(--on-surface)
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			background: unquote("color-mix(in oklab, var(--on-surface) 6%, transparent)")

	&__name
		font: var(--m3e-type-body-large)
		font-weight: 500
		color: var(--on-surface)
		white-space: nowrap
		overflow: hidden
		text-overflow: ellipsis

	/* 点线引导：与 SiteStats 同语言，沉到文字基线附近 */
	&__rule
		flex: 1
		align-self: flex-end
		margin-bottom: 0.35em
		min-width: 0.75rem
		border-bottom: 2px dotted var(--outline-variant)

	&__count
		font: var(--m3e-type-title-small)
		font-weight: 600
		font-variant-numeric: tabular-nums
		color: var(--on-surface-variant)
		white-space: nowrap

	&__empty
		display: flex
		align-items: center
		justify-content: center
		min-height: 11rem
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-large)

	@media (max-width: bp-sm - 1px)
		padding: 1rem 0.75rem

		&__list
			grid-template-columns: 1fr
</style>
