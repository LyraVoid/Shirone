a.card-github.fetch-waiting
  pointer-events: none
  opacity: 0.7
  transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard)

  .gc-description, .gc-infobar, .gc-avatar
    background-color: var(--on-surface-variant)
    color: transparent
    opacity: 0.5;
    animation: pulsate calc(var(--m3e-duration-long) * 5) infinite var(--m3e-easing-standard)
    user-select: none

    &:before
      background-color: transparent

  .gc-repo
    margin-left: -0.1rem

  .gc-description, .gc-infobar
    border-radius: var(--shape-corner-s)

  .gc-description
    min-height: 1.5em

a.card-github.fetch-error
  pointer-events: all
  opacity: 1

@keyframes pulsate
  0%
    opacity: 0.15
  50%
    opacity: 0.25
  100%
    opacity: 0.15

.gc-description, .gc-titlebar, .gc-stars, .gc-forks, .gc-license, .gc-avatar, .github-logo
  transition-property: color, background-color, opacity
  transition-timing-function: var(--m3e-easing-standard)
  transition-duration: var(--m3e-duration-short)
