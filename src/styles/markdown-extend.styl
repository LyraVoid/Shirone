.custom-md
  img
    border-radius: var(--shape-corner-m)

  hr
    border: 0
    border-top: 1px solid var(--line-divider)

  iframe
    border-radius: var(--shape-corner-m)
    margin-left: auto
    margin-right: auto
    max-width: 100%

a.card-github
  display: block
  position: relative
  margin: var(--m3e-space-2) 0
  padding: var(--m3e-space-4) var(--m3e-space-6)
  overflow: hidden
  background: var(--license-block-bg)
  color: var(--on-surface-variant)
  border: 0
  border-radius: var(--shape-corner-l)
  box-shadow: var(--m3e-elevation-0)
  text-decoration-thickness: 0
  text-decoration-line: none
  --m3e-state-color: var(--primary)
  transition-property: color, border-color, box-shadow, opacity
  transition-duration: var(--m3e-duration-short)
  transition-timing-function: var(--m3e-easing-standard)

  &:hover
    box-shadow: var(--m3e-elevation-1)

    .gc-titlebar
      color: var(--on-surface)

    .gc-stars, .gc-forks, .gc-license, .gc-description
      color: var(--on-surface)

      &:before
        background-color: var(--on-surface)

  .gc-titlebar
    display: flex
    align-items: center
    justify-content: space-between
    margin-bottom: var(--m3e-space-2)
    color: var(--on-surface)
    font: var(--m3e-type-title-medium)

    .gc-titlebar-left
      display: flex
      flex-flow: row nowrap
      gap: var(--m3e-space-2)

    .gc-repo
      font-weight: bold

    .gc-owner
      font-weight: 300
      position: relative
      display: flex
      flex-flow: row nowrap
      gap: var(--m3e-space-2)
      align-items: center

    .gc-avatar
      display: block
      overflow: hidden
      width: var(--m3e-space-6)
      height: var(--m3e-space-6)
      background-color: var(--primary)
      background-size: cover
      border-radius: var(--shape-corner-full)
      object-fit: cover

  .gc-description
    margin-bottom: var(--m3e-space-3)
    color: var(--on-surface-variant)
    font: var(--m3e-type-body-large)

  .gc-infobar
    display: flex
    flex-flow: row nowrap
    gap: var(--m3e-space-6)
    color: var(--on-surface-variant)
    width: fit-content

  .gc-language
    font: var(--m3e-type-label-large)

  .gc-stars, .gc-forks, .gc-license, .github-logo
    font: var(--m3e-type-label-large)

    &:before
      content: ' '
      display: inline-block
      height: 1.25em
      width: 1.25em
      margin-right: var(--m3e-space-1)
      vertical-align: -0.2em
      font-size: inherit
      background-color: var(--on-surface-variant)
      overflow: visible
      mask-size: contain
      mask-position: center
      mask-repeat: no-repeat
      transition-property: background-color
      transition-timing-function: var(--m3e-easing-standard)
      transition-duration: var(--m3e-duration-short)

  .gc-stars
