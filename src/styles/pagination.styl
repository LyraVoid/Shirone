
.m3-blog-pagination
	container-type: inline-size
	width: 100%
	display: flex
	align-items: center
	justify-content: center
	gap: var(--m3e-space-3)

	&__mobile
		display: flex
		align-items: center
		gap: var(--m3e-space-3)

	&__desktop
		display: none

	/* Largest window: eleven 48px targets + gaps; reserve 640px before expanding. */
	@container (min-width: 640px)
		&__mobile
			display: none
		&__desktop
			display: flex
			align-items: center
			gap: var(--m3e-space-3)

	&__arrow
		display: inline-flex
		align-items: center
		justify-content: center
		width: 3rem
		height: 3rem
		/* M3 accessible touch target: keep 48px even when mobile rem scales down. */
		min-width: 48px
		min-height: 48px
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		color: var(--primary)
		text-decoration: none
		--m3e-state-color: var(--primary)
		transition:
			background-color var(--m3e-duration-short) var(--m3e-easing-standard),
			transform var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(svg)
			width: 1.5rem
			height: 1.5rem

		&--disabled
			opacity: 0.38
			pointer-events: none

	/* 移动端跳转徽标：点击原地变输入框（脚本见下） */
	&__jump
		display: inline-flex
		align-items: center
		justify-content: center
		gap: var(--m3e-space-1)
		min-width: 5rem
		height: 3rem
		min-height: 48px
		padding: 0 var(--m3e-space-3)
		border: none
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		color: var(--on-surface)
		font: var(--m3e-type-label-large)
		--m3e-state-color: var(--on-surface)
		cursor: pointer
		transition:
			background-color var(--m3e-duration-short) var(--m3e-easing-standard),
			transform var(--m3e-duration-short) var(--m3e-easing-standard)

		&-current
			font-weight: 700
			color: var(--primary)

		&-sep
			color: var(--on-surface-variant)

		&-total
			color: var(--on-surface-variant)
			font-variant-numeric: tabular-nums

	/* 跳转输入框（脚本动态替换按钮） */
	&__jump-input
		width: 5rem
		height: 3rem
		min-height: 48px
		padding: 0 var(--m3e-space-2)
		border: none
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		color: var(--on-surface)
		font: var(--m3e-type-label-large)
		font-weight: 700
		text-align: center
		font-variant-numeric: tabular-nums
		outline: 2px solid var(--primary)
		outline-offset: -2px

	&__nums
		display: flex
		align-items: center
		gap: var(--m3e-space-2)

	&__num
		display: inline-flex
		align-items: center
		justify-content: center
		width: 3rem
		height: 3rem
		min-width: 48px
		min-height: 48px
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		font: var(--m3e-type-label-large)
		font-weight: 700
		text-decoration: none
		color: var(--on-surface-variant)
		--m3e-state-color: var(--on-surface)
		transition:
			background-color var(--m3e-duration-short) var(--m3e-easing-standard),
			color var(--m3e-duration-short) var(--m3e-easing-standard)

		&--active
			background: var(--primary)
			color: var(--on-primary)
			--m3e-state-color: var(--on-primary)
			&:hover
				background: var(--primary)

	&__ellipsis
		display: inline-flex
		align-items: center
		justify-content: center
		width: 1.5rem
		height: 3rem
		color: var(--on-surface-variant)
		> :global(svg)
			width: 1.25rem
			height: 1.25rem

.m3-blog-pagination button
	border: none
	cursor: pointer
	font: var(--m3e-type-label-large)
	font-weight: 700
	padding: 0

.m3-blog-pagination__arrow:disabled
	opacity: 0.38
	pointer-events: none

.m3-blog-pagination :focus-visible
	outline: 2px solid var(--primary)
	outline-offset: 2px
