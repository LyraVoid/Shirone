---
import { Font } from "astro:assets";
import Snackbar from "@components/atoms/overlay/Snackbar.svelte";
import ConfigCarrier from "@components/system/ConfigCarrier.astro";
import UmamiRuntime from "@components/system/UmamiRuntime.astro";
import {
	expressiveCodeConfig,
	profileConfig,
	resolvedFontOptions,
	resolveTextureOptions,
	resolveUmamiOptions,
	siteConfig,
	umamiConfig,
} from "@/config";
import type { SidebarPage } from "@/types/sidebarConfig";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { createFontRoleStyle } from "../utils/font-options";
import { resolvePageWidth } from "../utils/responsive-utils";
import { pathsEqual, url } from "../utils/url-utils";
import "../styles/main.css";
import "../styles/font-faces.css";
import textureStyles from "../styles/textures.css?raw";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	page?: SidebarPage;
}

let { title, description, lang, setOGTypeArticle, page } = Astro.props;

const initialPage =
	page ?? (pathsEqual(Astro.url.pathname, url("/")) ? "home" : undefined);

// `Astro.url` in a static build does not inherit a `site` set through an
// integration's `updateConfig()` — Astro snapshots the build origin in the
// build constructor before the `astro:config:setup` hook runs. Derive the
// absolute URL from `Astro.site` ourselves so og/twitter URLs stay correct.
const canonicalUrl = Astro.site
	? new URL(Astro.url.pathname + Astro.url.search, Astro.site)
	: Astro.url;

const configHue = siteConfig.themeColor.hue;
const lightTheme =
	expressiveCodeConfig.lightTheme ?? expressiveCodeConfig.theme;
const darkTheme = expressiveCodeConfig.darkTheme ?? expressiveCodeConfig.theme;
const defaultWallpaperMode = siteConfig.wallpaperMode.defaultMode;
const textureOptions = resolveTextureOptions();
const defaultTexturePreset = textureOptions.defaultPreset;
const defaultTextureOpacity = textureOptions.defaultOpacity;
const textureEnabled = textureOptions.enable;
const umamiOptions = resolveUmamiOptions(umamiConfig);

const hasDesktopBanner = siteConfig.banner.src.desktop.length > 0;
const hasMobileBanner = siteConfig.banner.src.mobile.length > 0;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");
const fontRoleStyle = createFontRoleStyle(resolvedFontOptions);
const customFontsEnabled = resolvedFontOptions.mode === "custom";
const hasBodyFont =
	customFontsEnabled && Boolean(resolvedFontOptions.roles.body.family);
const hasCjkFont =
	customFontsEnabled && Boolean(resolvedFontOptions.roles.cjk.family);
const hasMonoFont =
	customFontsEnabled && Boolean(resolvedFontOptions.roles.mono.family);
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]">
	<head>
		<style is:inline>@layer properties, theme, base, components, utilities;</style>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={canonicalUrl}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
			<meta property="og:type" content="article" />
		) : (
			<meta property="og:type" content="website" />
		)}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={canonicalUrl}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{fontRoleStyle && <style is:inline set:html={fontRoleStyle}></style>}
		{textureEnabled && <style is:inline set:html={textureStyles}></style>}
		{hasBodyFont && <Font cssVariable={resolvedFontOptions.roles.body.cssVariable as never} preload={resolvedFontOptions.roles.body.preload} />}
		{hasCjkFont && <Font cssVariable={resolvedFontOptions.roles.cjk.cssVariable as never} preload={resolvedFontOptions.roles.cjk.preload} />}
		{hasMonoFont && <Font cssVariable={resolvedFontOptions.roles.mono.cssVariable as never} preload={resolvedFontOptions.roles.mono.preload} />}
		{umamiOptions?.websiteId && umamiOptions.scriptUrl && (
			<script is:inline async src={umamiOptions.scriptUrl} data-website-id={umamiOptions.websiteId} data-auto-track="true"></script>
		)}
				{favicons.map(favicon => (
			<link rel="icon"
				href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				sizes={favicon.sizes}
				media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, configHue, lightTheme, darkTheme, defaultWallpaperMode, defaultTexturePreset, defaultTextureOpacity, textureEnabled}}>
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			let isDark = false;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					isDark = true;
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
						isDark = true;
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			document.documentElement.setAttribute('data-theme', isDark ? darkTheme : lightTheme);
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);
			if (localStorage.getItem('mc-motion') === 'reduced') {
				document.documentElement.classList.add('motion-reduced');
			}
			const storedWallpaperMode = localStorage.getItem('wallpaper-mode');
			const wallpaperMode = storedWallpaperMode === 'banner' || storedWallpaperMode === 'none'
				? storedWallpaperMode
				: defaultWallpaperMode;
			document.documentElement.dataset.wallpaperMode = wallpaperMode;

			if (textureEnabled) {
				const storedTexturePreset = localStorage.getItem('texture-preset');
				const validPresets = ['none', 'starlight', 'cyber-dots', 'topography', 'geometric', 'sakura'];
				const texturePreset = storedTexturePreset && validPresets.includes(storedTexturePreset)
					? storedTexturePreset
					: defaultTexturePreset;
				document.documentElement.dataset.texturePreset = texturePreset;
				const storedTextureOpacity = localStorage.getItem('texture-opacity');
				const textureOpacity = storedTextureOpacity ? parseFloat(storedTextureOpacity) : defaultTextureOpacity;
				if (!isNaN(textureOpacity)) {
					document.documentElement.style.setProperty('--texture-opacity', String(textureOpacity));
				}
			}

			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': resolvePageWidth(),
		}}></style>

		<slot name="head"></slot>
		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>
		<link rel="alternate" type="application/atom+xml" title={profileConfig.name} href={`${Astro.site}atom.xml`}/>
	</head>
	<body
		class="min-h-screen transition"
		data-current-page={initialPage}
		data-banner-visible="false"
		data-banner-layout="compact"
		data-banner-top-app-bar="false"
		data-banner-has-desktop={String(hasDesktopBanner)}
		data-banner-has-mobile={String(hasMobileBanner)}
	>
		<ConfigCarrier></ConfigCarrier>
		{umamiOptions && <UmamiRuntime />}
		{textureEnabled && (
			<div
				id="m3e-texture-canvas"
				class="fixed inset-0 pointer-events-none -z-20 transition-opacity duration-500"
				aria-hidden="true"
			></div>
		)}
		<Snackbar client:only="svelte"></Snackbar>
		<slot />
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style lang="stylus" is:global>
@import "../styles/variables.styl"
</style>

<style is:global define:vars={{
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
	'banner-panel-overlap': `${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem`,
}}>
@reference "../styles/main.css";
	@layer components {
		:root {
			--banner-stage-height: var(--banner-height-home);
			--banner-content-top: calc(var(--banner-stage-height) - var(--banner-panel-overlap));
		}
		#main-layout {
			top: 5.5rem;
			transition: top var(--m3e-duration-long) var(--m3e-easing-standard);
		}
		body[data-banner-layout="banner"] #main-layout { top: var(--banner-content-top); }
		body[data-banner-layout="banner"] #top-row { height: calc(var(--banner-stage-height) - 4.5rem); }
		.navbar-hidden { opacity: 0; transform: translateY(-4rem); }
	}
	@media (min-width: 1024px) {
		html[data-wallpaper-mode="banner"] body[data-banner-has-desktop="true"] #main-layout { top: var(--banner-content-top); }
		html[data-wallpaper-mode="banner"] body[data-banner-has-desktop="true"] #top-row { height: calc(var(--banner-stage-height) - 4.5rem); }
	}
	@media (max-width: 1023.98px) {
		:root { --banner-stage-height: max(70vh, 28rem); }
		@media (max-width: 479.98px) { :root { --banner-panel-overlap: var(--m3e-space-2); } }
		@media (min-width: 480px) and (max-width: 767.98px) { :root { --banner-panel-overlap: var(--m3e-space-2); } }
		html[data-wallpaper-mode="banner"] body[data-current-page="home"][data-banner-has-mobile="true"] #main-layout { top: var(--banner-content-top); }
		html[data-wallpaper-mode="banner"] body[data-current-page="home"][data-banner-has-mobile="true"] #top-row { height: calc(var(--banner-stage-height) - 4.5rem); }
		body[data-banner-layout="compact"] #top-row { height: auto; }
	}
	@media (min-width: 480px) and (max-width: 767.98px) { :root { --banner-stage-height: max(75vh, 31.25rem); } }
	@media (min-width: 768px) and (max-width: 1023.98px) { :root { --banner-stage-height: max(70vh, 31.25rem); } }
</style>

<script>
import { initLastUpdatedNotices } from "../utils/last-updated-notice";
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import { WALLPAPER_MODE_CHANGE_EVENT, BANNER_HEIGHT, BANNER_HEIGHT_EXTEND } from "../constants/constants";
import { copyPageLink } from "../utils/copy-page-link";

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener('click', event => {
		const panelDom = document.getElementById(panel);
		const target = event.target;
		if (!(target instanceof Node)) return;
		for (const ignore of ignores) {
			const element = document.getElementById(ignore);
			if (element === target || element?.contains(target)) return;
		}
		if (panelDom) panelDom.classList.add('float-panel-closed');
	});
}
setClickOutsideToClose('display-setting', ['display-setting', 'display-settings-switch']);
setClickOutsideToClose('search-panel', ['search-panel', 'search-bar', 'search-switch']);

function loadTheme() { setTheme(getStoredTheme()); }
function loadHue() { setHue(getHue()); }

function init() {
	loadTheme();
	loadHue();
}
init();
initLastUpdatedNotices();

document.addEventListener("click", async (event) => {
	const target = event.target;
	if (!(target instanceof Element) || !target.closest("#copy-post-link")) return;

	void copyPageLink();
});

const setup = () => {
	if (!window.swup || window.__shironeNavigationBound) return;
	window.__shironeNavigationBound = true;
	let scrollStarted = false;
	let visitActive = false;
	let finishTimer: number | undefined;
	function finishVisit() {
		if (!visitActive) return;
		visitActive = false;
		window.clearTimeout(finishTimer);
		finishTimer = window.setTimeout(() => {
			document.getElementById('page-height-extend')?.classList.add('hidden');
		}, 200);
	}
	window.swup.hooks.on('link:click', () => document.documentElement.style.setProperty('--content-delay', '0ms'));
	window.swup.hooks.on('visit:start', () => {
		window.clearTimeout(finishTimer);
		visitActive = true;
		scrollStarted = false;
		document.getElementById('page-height-extend')?.classList.remove('hidden');
	});
	window.swup.hooks.on('visit:end', () => { if (!scrollStarted) finishVisit(); });
	window.swup.hooks.on('visit:abort', finishVisit);
	if (window.swup.hooks.exists('scroll:end')) {
		window.swup.hooks.on('scroll:start', () => { if (visitActive) scrollStarted = true; });
		window.swup.hooks.on('scroll:end', finishVisit);
	}
};
if (window.swup?.hooks) setup();
else document.addEventListener('swup:enable', setup, { once: true });

const backToTopBtn = document.getElementById('back-to-top-btn');
function scrollFunction() {
	const scrollTop = Math.max(document.body.scrollTop, document.documentElement.scrollTop);
	const backToTopThreshold = window.innerHeight * (BANNER_HEIGHT / 100);
	backToTopBtn?.classList.toggle('hide', scrollTop <= backToTopThreshold);
	const bannerVisible = document.body.dataset.bannerVisible === 'true';
	const navbar = document.getElementById('navbar');
	const bannerStage = document.getElementById('banner-wrapper');
	const bannerBottom = bannerStage?.getBoundingClientRect().height ?? 0;
	const overBanner = bannerVisible && scrollTop < Math.max(0, bannerBottom - 64);
	document.body.dataset.bannerScrolled = String(!overBanner);
	navbar?.classList.toggle('top-app-bar--transparent', overBanner);
}
window.addEventListener('scroll', scrollFunction, { passive: true });
window.addEventListener('resize', () => {
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
	scrollFunction();
});
new MutationObserver(scrollFunction).observe(document.body, { attributes: true, attributeFilter: ['data-banner-visible', 'data-banner-layout'] });
window.addEventListener(WALLPAPER_MODE_CHANGE_EVENT, () => requestAnimationFrame(scrollFunction));
document.addEventListener('swup:page:view', scrollFunction);
scrollFunction();
</script>

<script>
import { bindFancyboxRuntime } from "../utils/fancybox-runtime";
import { applyStoredLayoutMode } from "../utils/layout-mode";

bindFancyboxRuntime();

const setup = () => {
	window.swup.hooks.on("content:replace", () => {
		applyStoredLayoutMode(document.getElementById("post-list"));
	});
};
if (window.swup) setup();
else document.addEventListener("swup:enable", setup);
</script>
