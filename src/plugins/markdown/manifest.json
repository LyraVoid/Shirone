		{
			"id": "content-annotation",
			"name": "Content Annotation",
			"status": "stable",
			"category": "inline-extension",
			"source": "shirone",
			"summary": "通过行内标签引用文章内集中定义的补充说明，并使用原生 Popover 在需要时显示内容。",
			"forms": [
				{
					"kind": "inline-reference",
					"pattern": "[+label]",
					"example": "Astro 使用孤岛架构 [+islands]。"
				},
				{
