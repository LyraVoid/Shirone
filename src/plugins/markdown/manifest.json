		},
		{
			"id": "spoiler",
			"name": "Inline Spoiler",
			"status": "legacy",
			"category": "text-directive",
			"source": "integration",
			"summary": "将 text directive 输出为 spoiler 自定义元素并使用 CSS 隐藏内容。",
			"forms": [
				{
					"kind": "text-directive",
