---
import CategoryList from "@components/atoms/blog/CategoryList.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSeriesCatalog, getSortedPostsList } from "@utils/content-utils";
import { normaliseSeriesSlug } from "@utils/series-utils";
import { getSeriesUrl, url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { seriesConfig } from "@/config";
import type { SeriesWidget } from "@/types/sidebarConfig";
import WidgetLayout from "./WidgetLayout.astro";

/**
 * 系列侧栏组件（与 Categories widget 同一「名称 + 数量徽标」形态，
 * 复用数据驱动的 CategoryList 原子）。
 * 超过侧栏展示上限（collapseAfter）时只展示前 N 项，并在卡片底部提供
 * 「查看全部系列」入口指向系列索引页（/series/）。
 * 站点没有任何系列时不渲染整个组件；seriesConfig.enable 为 false 时
 * 连取数都跳过（零额外负担：导航与 sitemap 已裁剪，侧栏入口必须同步消失）。
 */
interface Props {
	class?: string;
	style?: string;
	widget?: SeriesWidget;
}

const className = Astro.props.class;
const style = Astro.props.style;

const DISPLAY_LIMIT = Math.max(1, Astro.props.widget?.collapseAfter ?? 5);

interface SeriesItem {
	slug: string;
	title: string;
	count: number;
	latest: Date | null;
}

// 功能关闭时短路：不查集合、不产出 DOM
const catalog = seriesConfig.enable ? await getSeriesCatalog() : null;
const posts = catalog ? await getSortedPostsList() : [];

const seriesItems: SeriesItem[] = !catalog
	? []
	: [...catalog.entries()]
			.map(([slug, entity]) => {
				const members = posts.filter(
					(post) => normaliseSeriesSlug(post.data.series) === slug,
				);
				const latest = members.reduce<Date | null>((acc, post) => {
					const published = post.data.published;
					return acc === null || published > acc ? published : acc;
				}, null);
				return {
					slug,
					title: entity.data.title,
					count: members.length,
					latest,
				};
			})
			.sort((a, b) => (b.latest?.getTime() ?? 0) - (a.latest?.getTime() ?? 0));

const visibleItems = seriesItems.slice(0, DISPLAY_LIMIT).map((item) => ({
	name: item.title.trim(),
	href: getSeriesUrl(item.slug),
	count: item.count,
}));
const hasOverflow = seriesItems.length > DISPLAY_LIMIT;
---

{seriesItems.length > 0 && (
	<WidgetLayout name={i18n(I18nKey.series)} id="series" class={className} style={style}>
		<CategoryList categories={visibleItems} />
		{hasOverflow && (
			<div slot="footer" class="widget-index-link">
				<a href={url("/series/")} class="m3-state-layer">
					{i18n(I18nKey.seriesViewAll)}
					<Icon name="material-symbols:chevron-right-rounded" />
				</a>
			</div>
		)}
	</WidgetLayout>
)}

<style lang="stylus">
.widget-index-link
	padding: var(--m3e-space-2) var(--m3e-space-4) 0
	> a
		display: flex
		align-items: center
		justify-content: center
		gap: var(--m3e-space-1)
		width: 100%
		min-height: 2.5rem
		padding: 0 var(--m3e-space-2)
		border-radius: var(--shape-corner-m)
		color: var(--primary)
		font: var(--m3e-type-label-large)
		font-weight: 600
		text-decoration: none
		--m3e-state-color: var(--primary)
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(svg)
			width: 1.125rem
			height: 1.125rem
</style>
