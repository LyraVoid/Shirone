---
import CategoryList from "@components/atoms/blog/CategoryList.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getCategoryList } from "@utils/content-utils";
import { url } from "@utils/url-utils";
/**
 * 分类侧栏组件（消费 blog/CategoryList 原子）。
 * 只负责取数转 props：分类名 + URL + 计数。
 * 超过侧栏展示上限（collapseAfter）时，只展示前 N 项，并在卡片底部提供
 * 唯一的「查看全部分类」入口，指向分类索引页（/categories/）。
 */
import { Icon } from "astro-icon/components";
import type { CategoriesWidget } from "@/types/sidebarConfig";
import WidgetLayout from "./WidgetLayout.astro";

const categories = await getCategoryList();

interface Props {
	class?: string;
	style?: string;
	widget?: CategoriesWidget;
}
const className = Astro.props.class;
const style = Astro.props.style;

const DISPLAY_LIMIT = Math.max(1, Astro.props.widget?.collapseAfter ?? 5);
const hasOverflow = categories.length > DISPLAY_LIMIT;

const categoryItems = categories.slice(0, DISPLAY_LIMIT).map((c) => ({
	name: c.name.trim(),
	href: c.url,
	count: c.count,
}));
---

<WidgetLayout name={i18n(I18nKey.categories)} id="categories" class={className} style={style}>
	<CategoryList categories={categoryItems} />
	{hasOverflow && (
		<div slot="footer" class="widget-index-link">
			<a href={url("/categories/")} class="m3-state-layer">
				{i18n(I18nKey.categoriesViewAll)}
				<Icon name="material-symbols:chevron-right-rounded" />
			</a>
		</div>
	)}
</WidgetLayout>

<style lang="stylus">
.widget-index-link
	padding: var(--m3e-space-2) var(--m3e-space-4) 0
	> a
		display: flex
		align-items: center
		justify-content: center
		gap: var(--m3e-space-1)
		width: 100%
		min-height: 2.5rem
		padding: 0 var(--m3e-space-2)
		border-radius: var(--shape-corner-m)
		color: var(--primary)
		font: var(--m3e-type-label-large)
		font-weight: 600
		text-decoration: none
		--m3e-state-color: var(--primary)
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(svg)
			width: 1.125rem
			height: 1.125rem
</style>
