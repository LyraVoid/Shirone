---
/**
 * M3E 博客原子 — CategoryList 分类列表（text 按钮 + 数量徽标）。
 * 数据驱动：categories 为 { name, href, count? }[]。
 */
import Button from "@components/atoms/action/Button.svelte";

interface Props {
	categories: { name: string; href: string; count?: number }[];
	class?: string;
}

const { categories = [], class: className } = Astro.props;
---

<div class:list={["m3-blog-categorylist flex flex-col gap-0.5", className]}>
	{categories.map((c) => (
		<Button
			href={c.href}
			variant="text"
			size="small"
			full
			align="between"
			class="!px-2 !text-[var(--on-surface)]"
			
		>
			<span class="m3-blog-categorylist__name">{c.name}</span>
			{c.count !== undefined && (
				<span class="m3-blog-categorylist__badge">{c.count}</span>
			)}
		</Button>
	))}
</div>

<style lang="stylus">
.m3-blog-categorylist
	&__name
		overflow: hidden
		text-overflow: ellipsis
		white-space: nowrap
		min-width: 0

	&__badge
		display: inline-flex
		align-items: center
		justify-content: center
		flex-shrink: 0
		min-width: 2rem
		height: 1.75rem
		margin-left: var(--m3e-space-4)
		padding: 0 var(--m3e-space-2)
		border-radius: var(--shape-corner-s)
		background: var(--secondary-container)
		color: var(--on-secondary-container)
		font: var(--m3e-type-label-medium)
		font-weight: 700
		transition:
			background-color var(--m3e-duration-short) var(--m3e-easing-standard),
			color var(--m3e-duration-short) var(--m3e-easing-standard)
</style>
