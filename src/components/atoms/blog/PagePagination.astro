---
/**
 * M3E 博客原子 — PagePagination 分页器（数据驱动）。
 * currentPage / totalPages / buildUrl(page) 生成页码窗口（省略号折叠），
 * 响应式双形态：
 * - 窄容器（< 640px）：简化版 —— 上一页 + 「当前 / 总页」（点击原地变输入框
 *   跳转）+ 下一页，避免窄屏塞满页码按钮；
 * - 宽容器（≥ 640px）：完整页码行（箭头 + 页码窗口 + 省略号折叠）。
 * 激活页 primary 实底；文案由消费方传 i18n 结果（不硬编码）。
 */
import Icon from "@components/atoms/display/Icon.svelte";
import { paginationPages } from "@utils/pagination";

interface Props {
	currentPage: number;
	totalPages: number;
	/** 页码 → 链接地址（SSR 时由调用方注入，避免依赖路由工具） */
	buildUrl: (page: number) => string;
	/** 当前页左右展开的页码数（窗口宽 = adjacent*2+1） */
	adjacent?: number;
	/** 上一页 / 下一页 / 第 N 页 / 跳转到页面（消费方传 i18n 结果） */
	labels?: { prev: string; next: string; page: string; jump: string };
	class?: string;
	style?: string;
}

const {
	currentPage,
	totalPages,
	buildUrl,
	adjacent = 2,
	labels = {
		prev: "Previous",
		next: "Next",
		page: "Page {page}",
		jump: "Jump",
	},
	class: className,
	style,
} = Astro.props as Props;

const HIDDEN = -1;
const pages = paginationPages(currentPage, totalPages, adjacent);

const prevUrl = currentPage > 1 ? buildUrl(currentPage - 1) : undefined;
const nextUrl =
	currentPage < totalPages ? buildUrl(currentPage + 1) : undefined;
const jumpLabel = labels.jump;
// 跳转链接模板：占位符 {page} 由客户端替换；第 1 页特殊（buildUrl(1) 可能是 "/"）
const jumpTemplate = buildUrl(999_999).replace("999999", "{page}");
const jumpFirst = buildUrl(1);
const pageLabel = (p: number) => labels.page.replace("{page}", String(p));
---

<div class:list={["m3-blog-pagination", className]} style={style}>
	<!-- 移动端简化版：prev + 当前/总页（点击跳转）+ next -->
	<div class="m3-blog-pagination__mobile">
		{prevUrl ? (
			<a href={prevUrl} aria-label={labels.prev} class="m3-blog-pagination__arrow m3-state-layer">
				<Icon icon="material-symbols:chevron-left-rounded" />
			</a>
		) : (
			<span class="m3-blog-pagination__arrow m3-blog-pagination__arrow--disabled" aria-hidden="true">
				<Icon icon="material-symbols:chevron-left-rounded" />
			</span>
		)}
		<button
			type="button"
			class="m3-blog-pagination__jump m3-state-layer"
			aria-label={`${jumpLabel} ${currentPage} / ${totalPages}`}
			data-static-page-jump
			data-current={currentPage}
			data-total={totalPages}
			data-href-template={jumpTemplate}
			data-href-first={jumpFirst}
		>
			<span class="m3-blog-pagination__jump-current">{currentPage}</span>
			<span class="m3-blog-pagination__jump-sep" aria-hidden="true">/</span>
			<span class="m3-blog-pagination__jump-total">{totalPages}</span>
		</button>
		{nextUrl ? (
			<a href={nextUrl} aria-label={labels.next} class="m3-blog-pagination__arrow m3-state-layer">
				<Icon icon="material-symbols:chevron-right-rounded" />
			</a>
		) : (
			<span class="m3-blog-pagination__arrow m3-blog-pagination__arrow--disabled" aria-hidden="true">
				<Icon icon="material-symbols:chevron-right-rounded" />
			</span>
		)}
	</div>

	<!-- 桌面端完整版：箭头 + 页码窗口 + 省略号折叠 -->
	<div class="m3-blog-pagination__desktop">
		{prevUrl ? (
			<a
				href={prevUrl}
				aria-label={labels.prev}
				class="m3-blog-pagination__arrow m3-state-layer"
			>
				<Icon icon="material-symbols:chevron-left-rounded" />
			</a>
		) : (
			<span class="m3-blog-pagination__arrow m3-blog-pagination__arrow--disabled" aria-hidden="true">
				<Icon icon="material-symbols:chevron-left-rounded" />
			</span>
		)}
		<div class="m3-blog-pagination__nums">
			{pages.map((p) =>
				p === HIDDEN ? (
					<span class="m3-blog-pagination__ellipsis" aria-hidden="true">
						<Icon icon="material-symbols:more-horiz" />
					</span>
				) : p === currentPage ? (
					<span class="m3-blog-pagination__num m3-blog-pagination__num--active" aria-current="page">
						{p}
					</span>
				) : (
					<a class="m3-blog-pagination__num m3-state-layer" href={buildUrl(p)} aria-label={pageLabel(p)}>
						{p}
					</a>
				),
			)}
		</div>
		{nextUrl ? (
			<a
				href={nextUrl}
				aria-label={labels.next}
				class="m3-blog-pagination__arrow m3-state-layer"
			>
				<Icon icon="material-symbols:chevron-right-rounded" />
			</a>
		) : (
			<span class="m3-blog-pagination__arrow m3-blog-pagination__arrow--disabled" aria-hidden="true">
				<Icon icon="material-symbols:chevron-right-rounded" />
			</span>
		)}
	</div>
</div>

<style lang="stylus">
@import "../../../styles/pagination.styl"
</style>

<script>
	// 移动端页码跳转：点击「当前 / 总页」徽标原地变输入框，
	// Enter 跳转（第 1 页用 data-href-first，其余替换模板占位符）、
	// Esc / 失焦 / 非法输入还原徽标。
	// 事件委托挂在 document 上：分页器在 Swup 容器内，导航替换 DOM 后委托依然有效。
	document.addEventListener("click", (event) => {
		const btn = (event.target as HTMLElement | null)?.closest<HTMLElement>(
			".m3-blog-pagination__jump[data-static-page-jump]",
		);
		if (!btn) return;

		const current = btn.dataset.current || "1";
		const total = Number(btn.dataset.total || "1");
		const template = btn.dataset.hrefTemplate || "";
		const first = btn.dataset.hrefFirst || "/";
		const btnLabel = btn.getAttribute("aria-label") || "";

		const input = document.createElement("input");
		input.type = "text";
		input.inputMode = "numeric";
		input.maxLength = String(total).length;
		input.value = current;
		input.className = "m3-blog-pagination__jump-input";
		input.setAttribute("aria-label", btnLabel);

		const restore = () => {
			// Replacing a focused input fires blur; detach before mutating its DOM.
			input.removeEventListener("blur", restore);
			if (input.parentElement) {
				input.replaceWith(btn);
			}
		};

		btn.replaceWith(input);
		input.focus();
		input.select();

		const commit = () => {
			const n = Number.parseInt(input.value, 10);
			if (!Number.isInteger(n) || n < 1 || n > total) {
				restore();
				return;
			}
			window.location.href =
				n === 1 ? first : template.replace("{page}", String(n));
		};

		input.addEventListener("keydown", (event) => {
			if (event.key === "Enter") commit();
			if (event.key === "Escape") restore();
		});
		input.addEventListener("blur", restore);
	});
</script>
