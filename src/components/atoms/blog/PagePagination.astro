---
/**
 * M3E 博客原子 — PagePagination 分页器（数据驱动）。
 * currentPage / totalPages / buildUrl(page) 生成页码窗口（省略号折叠），
 * 响应式双形态：
 * - 移动端（< lg）：简化版 —— 上一页 + 「当前 / 总页」（点击原地变输入框
 *   跳转）+ 下一页，避免窄屏塞满页码按钮；
 * - 桌面端（≥ lg）：完整页码行（箭头 + 页码窗口 + 省略号折叠）。
 * 激活页 primary 实底；文案由消费方传 i18n 结果（不硬编码）。
 */
import { Icon } from "astro-icon/components";

interface Props {
	currentPage: number;
	totalPages: number;
	/** 页码 → 链接地址（SSR 时由调用方注入，避免依赖路由工具） */
	buildUrl: (page: number) => string;
	/** 当前页左右展开的页码数（窗口宽 = adjacent*2+1） */
	adjacent?: number;
	/** 上一页 / 下一页 / 第 N 页 / 跳转到页面（消费方传 i18n 结果） */
	labels?: { prev: string; next: string; page: string; jump: string };
	class?: string;
	style?: string;
}

const {
	currentPage,
	totalPages,
	buildUrl,
	adjacent = 2,
	labels = {
		prev: "Previous",
		next: "Next",
		page: "Page {page}",
		jump: "Jump",
	},
	class: className,
	style,
} = Astro.props as Props;

const HIDDEN = -1;
const VISIBLE = adjacent * 2 + 1;

let count = 1;
let l = currentPage;
let r = currentPage;
while (0 < l - 1 && r + 1 <= totalPages && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= totalPages && count < VISIBLE) {
	count++;
	r++;
}

const pages: (number | typeof HIDDEN)[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < totalPages - 2) pages.push(HIDDEN);
if (r === totalPages - 2) pages.push(totalPages - 1);
if (r < totalPages) pages.push(totalPages);

const prevUrl = currentPage > 1 ? buildUrl(currentPage - 1) : undefined;
const nextUrl =
	currentPage < totalPages ? buildUrl(currentPage + 1) : undefined;
const jumpLabel = labels.jump;
// 跳转链接模板：占位符 {page} 由客户端替换；第 1 页特殊（buildUrl(1) 可能是 "/"）
const jumpTemplate = buildUrl(999_999).replace("999999", "{page}");
const jumpFirst = buildUrl(1);
const pageLabel = (p: number) => labels.page.replace("{page}", String(p));
---

<div class:list={["m3-blog-pagination", className]} style={style}>
	<!-- 移动端简化版：prev + 当前/总页（点击跳转）+ next -->
	<div class="m3-blog-pagination__mobile">
		{prevUrl ? (
			<a href={prevUrl} aria-label={labels.prev} class="m3-blog-pagination__arrow m3-state-layer">
				<Icon name="material-symbols:chevron-left-rounded" />
			</a>
		) : (
			<span class="m3-blog-pagination__arrow m3-blog-pagination__arrow--disabled" aria-hidden="true">
				<Icon name="material-symbols:chevron-left-rounded" />
			</span>
		)}
		<button
			type="button"
			class="m3-blog-pagination__jump m3-state-layer"
			aria-label={jumpLabel}
			data-current={currentPage}
			data-total={totalPages}
			data-href-template={jumpTemplate}
			data-href-first={jumpFirst}
		>
			<span class="m3-blog-pagination__jump-current">{currentPage}</span>
			<span class="m3-blog-pagination__jump-sep" aria-hidden="true">/</span>
			<span class="m3-blog-pagination__jump-total">{totalPages}</span>
		</button>
		{nextUrl ? (
			<a href={nextUrl} aria-label={labels.next} class="m3-blog-pagination__arrow m3-state-layer">
				<Icon name="material-symbols:chevron-right-rounded" />
			</a>
		) : (
			<span class="m3-blog-pagination__arrow m3-blog-pagination__arrow--disabled" aria-hidden="true">
				<Icon name="material-symbols:chevron-right-rounded" />
			</span>
		)}
	</div>

	<!-- 桌面端完整版：箭头 + 页码窗口 + 省略号折叠 -->
	<div class="m3-blog-pagination__desktop">
		{prevUrl ? (
			<a
				href={prevUrl}
				aria-label={labels.prev}
				class="m3-blog-pagination__arrow m3-state-layer"
			>
				<Icon name="material-symbols:chevron-left-rounded" />
			</a>
		) : (
			<span class="m3-blog-pagination__arrow m3-blog-pagination__arrow--disabled" aria-hidden="true">
				<Icon name="material-symbols:chevron-left-rounded" />
			</span>
		)}
		<div class="m3-blog-pagination__nums">
			{pages.map((p) =>
				p === HIDDEN ? (
					<span class="m3-blog-pagination__ellipsis" aria-hidden="true">
						<Icon name="material-symbols:more-horiz" />
					</span>
				) : p === currentPage ? (
					<span class="m3-blog-pagination__num m3-blog-pagination__num--active" aria-current="page">
						{p}
					</span>
				) : (
					<a class="m3-blog-pagination__num m3-state-layer" href={buildUrl(p)} aria-label={pageLabel(p)}>
						{p}
					</a>
				),
			)}
		</div>
		{nextUrl ? (
			<a
				href={nextUrl}
				aria-label={labels.next}
				class="m3-blog-pagination__arrow m3-state-layer"
			>
				<Icon name="material-symbols:chevron-right-rounded" />
			</a>
		) : (
			<span class="m3-blog-pagination__arrow m3-blog-pagination__arrow--disabled" aria-hidden="true">
				<Icon name="material-symbols:chevron-right-rounded" />
			</span>
		)}
	</div>
</div>

<style lang="stylus">
.m3-blog-pagination
	display: flex
	align-items: center
	justify-content: center
	gap: var(--m3e-space-3)

	&__mobile
		display: flex
		align-items: center
		gap: var(--m3e-space-3)

	&__desktop
		display: none

	@media (min-width: 1024px)
		&__mobile
			display: none
		&__desktop
			display: flex
			align-items: center
			gap: var(--m3e-space-3)

	&__arrow
		display: inline-flex
		align-items: center
		justify-content: center
		width: 2.5rem
		height: 2.5rem
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		color: var(--primary)
		text-decoration: none
		--m3e-state-color: var(--primary)
		transition:
			background-color var(--m3e-duration-short) var(--m3e-easing-standard),
			transform var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(svg)
			width: 1.5rem
			height: 1.5rem
		&:hover:not(.m3-blog-pagination__arrow--disabled)
			background: var(--surface-container-high)

		&--disabled
			opacity: 0.38
			pointer-events: none

	/* 移动端跳转徽标：点击原地变输入框（脚本见下） */
	&__jump
		display: inline-flex
		align-items: center
		justify-content: center
		gap: var(--m3e-space-1)
		min-width: 5rem
		height: 2.5rem
		padding: 0 var(--m3e-space-3)
		border: none
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		color: var(--on-surface)
		font: var(--m3e-type-label-large)
		--m3e-state-color: var(--on-surface)
		cursor: pointer
		transition:
			background-color var(--m3e-duration-short) var(--m3e-easing-standard),
			transform var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			background: var(--surface-container-high)

		&-current
			font-weight: 700
			color: var(--primary)

		&-sep
			color: var(--on-surface-variant)

		&-total
			color: var(--on-surface-variant)
			font-variant-numeric: tabular-nums

	/* 跳转输入框（脚本动态替换按钮） */
	&__jump-input
		width: 5rem
		height: 2.5rem
		padding: 0 var(--m3e-space-2)
		border: none
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		color: var(--on-surface)
		font: var(--m3e-type-label-large)
		font-weight: 700
		text-align: center
		font-variant-numeric: tabular-nums
		outline: 2px solid var(--primary)
		outline-offset: -2px

	&__nums
		display: flex
		align-items: center
		gap: var(--m3e-space-2)

	&__num
		display: inline-flex
		align-items: center
		justify-content: center
		width: 2.5rem
		height: 2.5rem
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		font: var(--m3e-type-label-large)
		font-weight: 700
		text-decoration: none
		color: var(--on-surface-variant)
		--m3e-state-color: var(--on-surface)
		transition:
			background-color var(--m3e-duration-short) var(--m3e-easing-standard),
			color var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			background: var(--surface-container-high)

		&--active
			background: var(--primary)
			color: var(--on-primary)
			--m3e-state-color: var(--on-primary)
			&:hover
				background: var(--primary)

	&__ellipsis
		display: inline-flex
		align-items: center
		justify-content: center
		width: 1.5rem
		height: 2.5rem
		color: var(--on-surface-variant)
		> :global(svg)
			width: 1.25rem
			height: 1.25rem
</style>

<script>
	// 移动端页码跳转：点击「当前 / 总页」徽标原地变输入框，
	// Enter 跳转（第 1 页用 data-href-first，其余替换模板占位符）、
	// Esc / 失焦 / 非法输入还原徽标。
	// 事件委托挂在 document 上：分页器在 Swup 容器内，导航替换 DOM 后委托依然有效。
	document.addEventListener("click", (event) => {
		const btn = (event.target as HTMLElement | null)?.closest<HTMLElement>(
			".m3-blog-pagination__jump",
		);
		if (!btn) return;

		const current = btn.dataset.current || "1";
		const total = Number(btn.dataset.total || "1");
		const template = btn.dataset.hrefTemplate || "";
		const first = btn.dataset.hrefFirst || "/";
		const btnLabel = btn.getAttribute("aria-label") || "";

		const input = document.createElement("input");
		input.type = "text";
		input.inputMode = "numeric";
		input.maxLength = String(total).length;
		input.value = current;
		input.className = "m3-blog-pagination__jump-input";
		input.setAttribute("aria-label", btnLabel);

		const restore = () => {
			if (input.parentElement) {
				input.replaceWith(btn);
			}
		};

		btn.replaceWith(input);
		input.focus();
		input.select();

		const commit = () => {
			const n = Number.parseInt(input.value, 10);
			if (!Number.isInteger(n) || n < 1 || n > total) {
				restore();
				return;
			}
			window.location.href =
				n === 1 ? first : template.replace("{page}", String(n));
		};

		input.addEventListener("keydown", (event) => {
			if (event.key === "Enter") commit();
			if (event.key === "Escape") restore();
		});
		input.addEventListener("blur", restore);
	});
</script>
