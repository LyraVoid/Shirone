---
import Button from "@components/atoms/action/Button.svelte";
import Icon from "@components/atoms/display/Icon.svelte";
import LoadingIndicator from "@components/atoms/feedback/LoadingIndicator.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import stylus from "stylus";
import type { CommentContext, WalineConfig } from "@/types/commentConfig";

interface Props {
	context: CommentContext;
	config: WalineConfig;
	lazy?: boolean;
}

const { context, config, lazy = true } = Astro.props;
const { scriptUrl, styleUrl, lang, ...clientOptions } = config;

// Waline 使用 jp 表示日语；未内置的站点语言显式回退英语，避免落到中文默认值。
const languages: Record<string, string> = {
	zh: "zh-CN",
	"zh-cn": "zh-CN",
	"zh-tw": "zh-TW",
	"zh-hk": "zh-TW",
	"zh-hans": "zh-CN",
	"zh-hant": "zh-TW",
	jp: "jp",
	ja: "jp",
	en: "en",
	es: "es",
	ko: "ko",
	vi: "vi",
};
const siteLanguage = context.language.toLowerCase().replaceAll("_", "-");
const resolvedLang =
	lang === "auto"
		? (languages[siteLanguage] ?? languages[siteLanguage.split("-")[0]] ?? "en")
		: lang;
const options = {
	...clientOptions,
	path: context.path,
	lang: resolvedLang,
	// 颜色由下方局部语义 token 跟随站点切换，无需 SDK 注入全局暗色样式。
	dark: false,
	comment: false,
	pageview: false,
};

// 内嵌编译，避免 Astro 将未启用 provider 的样式提升进共享 CSS。
const walineStylus = `
.shirone-waline-wrapper
	display: block
	min-width: 0
	font: var(--m3e-type-body-medium)
	--waline-font-size: 1em
	--waline-white: var(--on-primary)
	--waline-light-grey: var(--on-surface-variant)
	--waline-dark-grey: var(--on-surface-variant)
	--waline-theme-color: var(--primary)
	--waline-active-color: var(--primary)
	--waline-color: var(--on-surface)
	--waline-bg-color: var(--card-bg)
	--waline-bg-color-light: var(--surface-container-low)
	--waline-bg-color-hover: var(--surface-container-high)
	--waline-border-color: var(--outline-variant)
	--waline-disable-bg-color: var(--surface-container-highest)
	--waline-disable-color: var(--on-surface-variant)
	--waline-code-bg-color: var(--codeblock-bg)
	--waline-warning-color: var(--on-tertiary-container)
	--waline-warning-bg-color: var(--tertiary-container)
	--waline-bq-color: var(--surface-container-high)
	--waline-badge-color: var(--primary)
	--waline-info-bg-color: var(--surface-container-high)
	--waline-info-color: var(--on-surface-variant)
	--waline-avatar-radius: var(--shape-corner-full)
	--waline-box-shadow: none
	--shirone-waline-control-size: var(--m3e-space-10)

	.waline-loading:not([hidden])
		display: flex
		flex-direction: column
		align-items: center
		justify-content: center
		gap: var(--m3e-space-3)
		min-height: 10rem
		padding-block: var(--m3e-space-6)
		color: var(--on-surface-variant)

	.waline-error
		padding: var(--m3e-space-4)
		border-radius: var(--shape-corner-m)
		background: var(--error-container)
		color: var(--on-error-container)
		text-align: center

	.waline-error p
		margin-bottom: var(--m3e-space-3)

	.waline-noscript
		padding: var(--m3e-space-4)
		color: var(--on-surface-variant)
		text-align: center

	.waline-upload-label
		display: none

	.wl-comment
		gap: var(--m3e-space-3)

	.wl-panel
		box-sizing: border-box
		min-width: 0
		margin: 0
		border: none
		border-radius: var(--shape-corner-l)

	.wl-header
		display: grid
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr))
		gap: var(--m3e-space-2)
		overflow: visible
		padding: var(--m3e-space-3)
		border: none
		border-radius: inherit

	// Match TextField's filled variant: centered empty label, floating active label.
	.wl-header .wl-header-item
		position: relative
		display: block
		box-sizing: border-box
		min-width: 0
		width: auto
		height: calc(var(--m3e-space-6) * 2)
		padding: 0 var(--m3e-space-4)
		border: none
		border-radius: var(--shape-corner-m)
		background: var(--field-filled-bg)
		--m3e-state-hover-alpha: 12%
		--m3e-state-focus-alpha: 16%

	.wl-header label
		position: absolute
		inset-inline: var(--m3e-space-4)
		top: 50%
		transform: translateY(-50%)
		min-width: 0
		padding: 0
		overflow: hidden
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-large)
		text-align: start
		text-overflow: ellipsis
		white-space: nowrap
		pointer-events: none
		transition: top var(--m3e-duration-short) var(--m3e-easing-standard), transform var(--m3e-duration-short) var(--m3e-easing-standard), font-size var(--m3e-duration-short) var(--m3e-easing-standard), color var(--m3e-duration-short) var(--m3e-easing-standard)

	.wl-header-item:focus-within label, .wl-header-item:has(input:not(:placeholder-shown)) label
		top: var(--m3e-space-1)
		transform: none
		color: var(--primary)
		font: var(--m3e-type-body-small)

	.wl-header input.wl-input
		display: block
		box-sizing: border-box
		min-width: 0
		width: 100%
		height: 100%
		padding: var(--m3e-space-5) 0 var(--m3e-space-1)
		border: none
		border-radius: 0
		background: transparent
		color: var(--on-surface)
		caret-color: var(--primary)
		font: var(--m3e-type-body-large)

	.wl-header input.wl-input:focus
		background: transparent

	// TextField's inset focus indicator, rather than a perimeter around each field.
	.wl-header-item::after
		content: ''
		position: absolute
		inset-inline: var(--m3e-space-2)
		bottom: var(--m3e-space-1)
		height: 2px
		border-radius: var(--shape-corner-full)
		background: var(--primary)
		opacity: 0
		transform: scaleX(0.5)
		pointer-events: none
		transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard), transform var(--m3e-duration-short) var(--m3e-easing-emphasized-decelerate)

	.wl-header-item:focus-within::after
		opacity: 1
		transform: scaleX(1)

	// The emoji input (utils/emoji-input) edits in place of the SDK textarea, which
	// stays hidden as Waline's model; both wear the same filled field.
	.wl-panel > .wl-editor, .wl-panel > .emoji-input
		min-width: 0
		width: calc(100% - var(--m3e-space-3) * 2)
		margin: 0 var(--m3e-space-3) var(--m3e-space-2)
		padding: var(--m3e-space-3)
		border: none
		border-radius: var(--shape-corner-m)
		box-shadow: none
		background-color: var(--field-filled-bg)
		// Textareas cannot host a pseudo-element; paint the same 2px inset indicator.
		background-image: linear-gradient(var(--primary), var(--primary))
		background-repeat: no-repeat
		background-position: center calc(100% - var(--m3e-space-1))
		background-size: 0 2px
		caret-color: var(--primary)
		font: var(--m3e-type-body-large)
		transition-property: background-color, background-size

	.wl-panel > .wl-editor[hidden]
		display: none

	// Grows with its content like the autosized textarea, from the same minimum.
	.wl-panel > .emoji-input
		position: relative
		box-sizing: border-box
		min-height: 8.75em
		color: var(--on-surface)
		white-space: pre-wrap
		overflow-wrap: anywhere
		cursor: text
		outline: none

	.emoji-input[data-empty]::before
		content: attr(data-placeholder)
		position: absolute
		inset-inline: var(--m3e-space-3)
		top: var(--m3e-space-3)
		color: var(--on-surface-variant)
		pointer-events: none

	// Same height as the published .wl-emoji, centred on the line it sits in.
	.emoji-input__glyph
		display: inline-block
		width: auto
		height: 1.25em
		margin-inline: 0.0625em
		vertical-align: -0.25em

	// Logged-in and metadata-free editors have no header to provide top spacing.
	.wl-panel > .wl-editor:first-child, .wl-panel > .wl-editor:first-child + .emoji-input
		margin-block-start: var(--m3e-space-3)

	// Keep the filled TextField's 12% hover / 16% focus surface state on the editor.
	.wl-panel > .wl-editor:hover, .wl-panel > .emoji-input:hover
		background-color: unquote("color-mix(in oklab, var(--on-surface) 12%, var(--field-filled-bg))")

	.wl-panel > .wl-editor:focus, .wl-panel > .emoji-input:focus
		background-color: unquote("color-mix(in oklab, var(--on-surface) 16%, var(--field-filled-bg))")
		background-size: calc(100% - var(--m3e-space-2) * 2) 2px

	.wl-footer
		align-items: center
		gap: var(--m3e-space-2)
		margin: var(--m3e-space-2) var(--m3e-space-3) var(--m3e-space-3)

	.wl-actions
		flex: 1 1 auto
		flex-wrap: wrap
		gap: var(--m3e-space-1)

	button.wl-action, a.wl-action, .wl-close
		display: inline-flex
		align-items: center
		justify-content: center
		flex-shrink: 0
		width: var(--shirone-waline-control-size)
		height: var(--shirone-waline-control-size)
		margin: 0
		padding: 0
		border: none
		border-radius: var(--shape-corner-m)
		background: transparent
		color: var(--on-surface-variant)

	.wl-action.active
		background: var(--secondary-container)
		color: var(--on-secondary-container)
		--m3e-state-color: var(--on-secondary-container)

	.waline-icon-button > svg:not(.waline-icon)
		display: none

	.waline-icon
		width: var(--m3e-space-6)
		height: var(--m3e-space-6)
		pointer-events: none

	// Keep the reply action in its own row, outside the fields and their focus rings.
	.wl-comment:has(> .wl-close)
		padding-block-start: calc(var(--shirone-waline-control-size) + var(--m3e-space-2))

	.wl-close
		inset-inline-end: 0
		top: 0
		background: var(--secondary-container)
		color: var(--on-secondary-container)
		--m3e-state-color: var(--on-secondary-container)

	// Both SDK nodes share the image corner as their center, including wide counts.
	.wl-reaction-votes, .wl-reaction-loading
		position: absolute
		box-sizing: border-box
		top: 0
		inset-inline-end: 0
		min-width: var(--m3e-space-5)
		height: var(--m3e-space-5)
		margin: 0
		transform: translate(50%, -50%)

	.wl-reaction-votes:dir(rtl), .wl-reaction-loading:dir(rtl)
		transform: translate(-50%, -50%)

	.wl-reaction-votes
		display: grid
		place-items: center
		padding: 0 var(--m3e-space-1)
		border-radius: var(--shape-corner-full)
		font: var(--m3e-type-label-small)

	.wl-reaction-loading
		width: var(--m3e-space-5)

	.wl-meta-foot
		flex-wrap: wrap
		gap: var(--m3e-space-2)

	.wl-meta-foot > .wl-rss
		flex-wrap: wrap
		gap: var(--m3e-space-2)
		min-width: 0
		max-width: none
		overflow: visible
		transition: none

	.wl-meta-foot .wl-rss > a
		box-sizing: border-box
		display: inline-flex
		align-items: center
		gap: var(--m3e-space-2)
		flex-shrink: 1
		min-height: var(--shirone-waline-control-size)
		max-width: 100%
		padding: var(--m3e-space-2)
		border-radius: var(--shape-corner-m)
		color: var(--primary)
		font: var(--m3e-type-body-small)
		text-decoration: none

	.wl-meta-foot .wl-rss span
		color: inherit
		font: inherit
		text-align: start
		overflow-wrap: anywhere

	.wl-meta-foot .wl-rss .waline-icon
		order: -1
		flex-shrink: 0

	.wl-power, .wl-word
		font: var(--m3e-type-body-small)

	.wl-btn
		border-radius: var(--shape-corner-m)
		font: var(--m3e-type-label-large)

	.wl-btn, .wl-input, .wl-editor, .emoji-input, .wl-sort li
		transition-duration: var(--m3e-duration-short)
		transition-timing-function: var(--m3e-easing-standard)

@media (max-width: 600px)
	.shirone-waline-wrapper .wl-header
		grid-template-columns: minmax(0, 1fr)

@media (pointer: coarse)
	.shirone-waline-wrapper
		--shirone-waline-control-size: calc(var(--m3e-space-6) * 2)

/* !important boundary: Waline owns its generated animations/transitions;
   this integration enforces both Shirone and OS reduced-motion preferences. */
html.motion-reduced .shirone-waline-wrapper [data-waline] *
	animation: none !important
	transition: none !important

@media (prefers-reduced-motion: reduce)
	.shirone-waline-wrapper [data-waline] *
		animation: none !important
		transition: none !important
`;
const walineStyles = await new Promise<string>((resolve, reject) => {
	stylus.render(walineStylus, (error, css) => {
		if (error) reject(error);
		else resolve(css);
	});
});
---

<shirone-waline
	class="shirone-waline-wrapper"
	data-waline-script-url={scriptUrl}
	data-waline-style-url={styleUrl}
	data-waline-options={JSON.stringify(options)}
	data-waline-editor-label={i18n(I18nKey.commentsEditor)}
	data-waline-lazy={lazy ? "true" : "false"}
	data-waline-state="loading"
>
	<!-- SSR icon templates stay inert until the enabled SDK renders its controls. -->
	<template data-waline-icon="emoji">
		<Icon icon="material-symbols:sentiment-satisfied-outline-rounded" class="waline-icon" aria-hidden="true" />
	</template>
	<template data-waline-icon="image">
		<Icon icon="material-symbols:image-outline-rounded" class="waline-icon" aria-hidden="true" />
	</template>
	<template data-waline-icon="preview">
		<Icon icon="material-symbols:visibility-outline-rounded" class="waline-icon" aria-hidden="true" />
	</template>
	<template data-waline-icon="close">
		<Icon icon="material-symbols:close-rounded" class="waline-icon" aria-hidden="true" />
	</template>
	<template data-waline-icon="rss">
		<Icon icon="material-symbols:rss-feed-rounded" class="waline-icon" aria-hidden="true" />
	</template>
	<div class="waline-loading" role="status" hidden>
		<span aria-hidden="true"><LoadingIndicator client:visible /></span>
		<span>{i18n(I18nKey.commentsLoading)}</span>
	</div>
	<div class="waline-container" data-waline hidden></div>
	<div class="waline-error" hidden>
		<p role="alert">{i18n(I18nKey.commentsLoadFailed)}</p>
		<Button class="waline-retry" variant="tonal" label={i18n(I18nKey.retry)} />
	</div>
	<noscript>
		<p class="waline-noscript">{i18n(I18nKey.commentsRequiresJavaScript)}</p>
	</noscript>
</shirone-waline>

<style is:inline set:html={walineStyles}></style>

<script>
	import "@utils/waline-runtime";
</script>
