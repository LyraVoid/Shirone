---
/**
 * 分类导航栏（全站复用）。
 * 外层 Card 原子容器 + 内层 flex：Home / Archive / 各分类 pill，
 * 分类区横向滚动。当前页 primary 实底强高亮；文章页所属分类 primary-container
 * 弱高亮（M3 次级语义）。query 分类筛选由客户端 JS 在加载 + swup 导航时更新。
 */
import Chip from "@components/atoms/action/Chip.astro";
import Card from "@components/atoms/display/Card.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getCategoryList } from "@utils/content-utils";
import { pathsEqual, url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Props {
	/** 文章页所属分类名：非首页/归档时对该分类做弱高亮 */
	currentPostCategory?: string;
}

const { currentPostCategory } = Astro.props;

const categories = await getCategoryList();
const homeUrl = url("/");
const archiveUrl = url("/archive/");

const pathname = Astro.url.pathname;
const isHome = pathsEqual(pathname, homeUrl);
const isArchive = pathsEqual(pathname, archiveUrl);
const postCategory = (currentPostCategory || "").trim();

// SSR 初始高亮：
// - 首页 → home 强高亮；归档 → archive 强高亮；
// - 文章页 → 所属分类弱高亮（soft）；
// - 其它（关于等）→ 无高亮。
// query 分类（?category=）在静态站点构建期不可知，由客户端校正。
const softCategory = !isHome && !isArchive && postCategory ? postCategory : "";
---

<!-- nav landmark：分类栏静态渲染在 Swup 容器外，需要独立 landmark 才能通过
     axe region 规则（内容必须处于某个 landmark 区域内） -->
<nav
	id="category-bar-region"
	aria-label={i18n(I18nKey.categories)}
	class:list={{ hidden: Astro.url.pathname.startsWith("/categories") || Astro.url.pathname.startsWith("/tags") }}
>
	<Card color="var(--card-bg)" radius="l" class="category-bar onload-animation mb-4 p-2" id="category-bar">
		<div class="category-bar-inner flex gap-2 items-center">
			<Chip
				variant="tonal"
				href={homeUrl}
				selected={isHome}
				label={i18n(I18nKey.home)}
				class="shrink-0"
			>
				<Icon name="material-symbols:home" class="text-lg" aria-hidden="true" />
			</Chip>
			<Chip
				variant="tonal"
				href={archiveUrl}
				selected={isArchive}
				class="shrink-0"
			>
				{i18n(I18nKey.archive)}
			</Chip>

			<!-- 分类区：横向滚动 -->
			<div class="category-bar-list flex gap-2 overflow-x-auto hide-scrollbar flex-1 min-w-0">
				{categories.map((cat) => (
					<Chip
						variant="tonal"
						href={cat.url}
						selected={false}
						soft={cat.name === softCategory}
						class="shrink-0"
					>
						{cat.name}
						<span class="category-bar__count" aria-hidden="true">{cat.count}</span>
					</Chip>
				))}
			</div>
		</div>
	</Card>
</nav>

<style lang="stylus">
	.category-bar__count
		font-size: 0.7rem
		font-weight: 600
		padding: 0.05rem 0.35rem
		border-radius: 0.375rem
		background: var(--btn-regular-bg-active)
		color: var(--btn-content)

	// 选中态：数字反转成 on-primary 底 + primary 字，保证高对比可读。
	// 用 :global() 跳过 Astro 作用域，否则 .m3-chip--selected 会被挂上
	// CategoryBar 自己的 data-astro-cid，无法命中 Chip 渲染出来的 <a>。
	:global(.m3-chip--selected) .category-bar__count
		background: var(--on-primary)
		color: var(--primary)
		opacity: 1
</style>

<script>
	// 高亮同步：分类栏静态渲染在 Swup 容器外，导航后不重渲染，
	// 因此强高亮（首页/归档/分类筛选）与弱高亮（文章页所属分类）都要在这里维护。
	// 文章页所属分类从 #swup-container 的 data-current-post-category 读取。
	// 用 pill 的 href 与当前 URL 比对（Chip 原子不透传 data-* 属性）。
	function syncCategoryBar() {
		const bar = document.getElementById("category-bar");
		if (!bar) return;

		const swupContainer = document.getElementById("swup-container");
		const currentPage = swupContainer?.dataset.currentPage;
		document
			.getElementById("category-bar-region")
			?.classList.toggle("hidden", currentPage === "categories" || currentPage === "tags");
		const postCategory = (swupContainer?.dataset.currentPostCategory || "").trim();

		const pathname = window.location.pathname.replace(/\/+$/, "") || "/";
		const params = new URLSearchParams(window.location.search);
		const categoryParam = params.get("category");

		let active: string;
		if (pathname === "/") {
			active = "__home__";
		} else if (categoryParam) {
			active = `category=${categoryParam}`;
		} else if (pathname === "/archive") {
			active = "__archive__";
		} else {
			active = "";
		}

		// 弱高亮只在无强高亮的页面出现（文章页所属分类，与 SSR soft 逻辑一致）
		const softCategory =
			active === "" && postCategory && pathname !== "/" && pathname !== "/archive"
				? postCategory
				: "";

		const pills = bar.querySelectorAll<HTMLAnchorElement>("a.m3-chip");
		pills.forEach((pill) => {
			const href = pill.getAttribute("href") || "";
			const normalizedHref = href.replace(/\/+$/, "") || "/";
			const isActive =
				active === ""
					? false
					: active === "__home__"
					? normalizedHref === "/"
					: active === "__archive__"
						? href.includes("/archive/") && !href.includes("category=") && !href.includes("tag=")
						: href.includes(`category=${encodeURIComponent(categoryParam!)}`);
			pill.classList.toggle("m3-chip--selected", isActive);

			// 文章页所属分类弱高亮（primary-container 次级语义）
			const isSoft =
				!isActive &&
				softCategory !== "" &&
				href.includes(`category=${encodeURIComponent(softCategory)}`);
			pill.classList.toggle("m3-chip--soft", isSoft);
		});
	}

	syncCategoryBar();

	// Swup 导航后 URL 变化，重新同步（首页/归档/分类筛选互跳）
	if (window.swup?.hooks) {
		window.swup.hooks.on("content:replace", syncCategoryBar);
	} else {
		document.addEventListener("swup:enable", () => {
			window.swup?.hooks.on("content:replace", syncCategoryBar);
		});
	}
</script>
