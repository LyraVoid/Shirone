# 服务监听地址与端口
HTTP_ADDRESS=:8080

# 跨域允许 Origin（多个逗号分隔）
HTTP_ALLOWED_ORIGINS=http://localhost:4321

# 数据库驱动: 'sqlite' 或 'postgres'
DB_DRIVER=sqlite
DATABASE_URL=file:./data/shirone.db?_pragma=foreign_keys(1)

# 会话与安全
AUTH_COOKIE_NAME=shirone_session
AUTH_COOKIE_SECURE=false

# 媒体存储目录
STORAGE_LOCAL_DIR=./data/media
